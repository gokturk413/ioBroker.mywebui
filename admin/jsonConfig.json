{
  "type": "tabs",
  "i18n": true,
  "items": {
    "tab_license": {
      "type": "panel",
      "label": "License",
      "items": {
        "_info": {
          "type": "header",
          "text": "WebUI Adapter Configuration",
          "size": 3
        },
        "_licenseInfo": {
          "type": "staticText",
          "text": "This adapter requires a valid license key to operate. The license is bound to your hardware for security purposes.",
          "style": {
            "fontSize": 14,
            "color": "#666",
            "marginBottom": 20
          }
        },
        "licenseKey": {
          "type": "password",
          "label": "License Key",
          "sm": 12,
          "md": 8,
          "lg": 6,
          "help": "Enter your license key here. Contact gokturk413 for a valid license key.",
          "visible": true,
          "repeat": false
        },
        "_licenseWarning": {
          "type": "staticText",
          "text": "⚠️ Important: License keys are cryptographically bound to hardware IDs. To add a new computer, contact gokturk413 with your Hardware ID.",
          "style": {
            "fontSize": 13,
            "color": "#ff9800",
            "marginTop": 10,
            "padding": "10px",
            "backgroundColor": "#fff3e0",
            "borderRadius": "4px"
          }
        },
        "_hwidHeader": {
          "type": "header",
          "text": "Your Hardware ID",
          "size": 4,
          "marginTop": 10
        },
        "hardwareId": {
          "type": "text",
          "label": "Hardware ID",
          "readOnly": true,
          "copyToClipboard": true,
          "sm": 12,
          "md": 10,
          "lg": 8,
          "help": "Send this ID to gokturk413 to receive a license key for this computer."
        },
        "_getHwidBtn": {
          "type": "sendTo",
          "label": "Show / refresh my Hardware ID",
          "command": "getHardwareId",
          "jsonData": "{}",
          "variant": "contained",
          "icon": "info",
          "useNative": true,
          "onLoaded": true,
          "sm": 12,
          "md": 4
        },
        "_hardwareIdInfo": {
          "type": "staticText",
          "text": "ℹ️ The Hardware ID above identifies this computer. Send it to gokturk413 to get a license key. You cannot manually add hardware IDs — they are cryptographically bound inside the license key.",
          "style": {
            "fontSize": 12,
            "color": "#2196F3",
            "marginTop": 10,
            "padding": "8px",
            "backgroundColor": "#e3f2fd",
            "borderRadius": "4px"
          }
        },
        "_separator": {
          "type": "divider"
        },
        "_instructionsHeader": {
          "type": "header",
          "text": "Setup Instructions",
          "size": 4
        },
        "_instructions": {
          "type": "staticText",
          "text": "1. Start the adapter (it will fail on first run)\n2. Check logs: iobroker logs webui --lines 50\n3. Copy your Hardware ID from logs\n4. Send Hardware ID to gokturk413 to get a license\n5. Enter the license key here\n6. Restart the adapter\n\n💡 To add another computer: Send its Hardware ID to get an updated license key.",
          "style": {
            "fontSize": 13,
            "fontFamily": "monospace",
            "whiteSpace": "pre-line",
            "padding": "10px",
            "backgroundColor": "#f5f5f5",
            "borderRadius": "4px"
          }
        },
        "_contactInfo": {
          "type": "staticText",
          "text": "📧 Contact: gokturk413 | 🔒 Licensed Software",
          "style": {
            "fontSize": 12,
            "color": "#999",
            "marginTop": 20,
            "textAlign": "center"
          }
        }
      }
    },
    "tab_grafana": {
      "type": "panel",
      "label": "Grafana",
      "items": {
        "_grafanaHeader": {
          "type": "header",
          "text": "Grafana Integration",
          "size": 3
        },
        "_grafanaInfo": {
          "type": "staticText",
          "text": "If Grafana is not installed or nginx is not configured, keep this disabled. The adapter will not throw any errors.",
          "style": {
            "fontSize": 13,
            "color": "#666",
            "marginBottom": 16,
            "padding": "8px",
            "backgroundColor": "#f5f5f5",
            "borderRadius": "4px"
          }
        },
        "grafanaEnabled": {
          "type": "checkbox",
          "label": "Enable Grafana Integration",
          "sm": 12,
          "default": false
        },
        "_sep1": {
          "type": "divider",
          "hidden": "!data.grafanaEnabled"
        },
        "_grafanaUrlHeader": {
          "type": "header",
          "text": "Grafana Connection",
          "size": 4,
          "hidden": "!data.grafanaEnabled"
        },
        "grafanaUrl": {
          "type": "text",
          "label": "Grafana Internal URL",
          "sm": 12,
          "md": 8,
          "lg": 6,
          "default": "http://localhost:3000",
          "help": "Internal URL of Grafana (not nginx proxy URL)",
          "hidden": "!data.grafanaEnabled"
        },
        "_sep2": {
          "type": "divider",
          "hidden": "!data.grafanaEnabled"
        },
        "_featuresHeader": {
          "type": "header",
          "text": "Features",
          "size": 4,
          "hidden": "!data.grafanaEnabled"
        },
        "grafanaLangSyncEnabled": {
          "type": "checkbox",
          "label": "Language Sync (webui → Grafana)",
          "sm": 12,
          "default": false,
          "help": "When user changes language in webui, also update Grafana UI language",
          "hidden": "!data.grafanaEnabled"
        },
        "_langSyncInfo": {
          "type": "staticText",
          "text": "ℹ️ Requires Grafana Auth Proxy (X-WEBAUTH-USER) to be enabled in grafana.ini.\n[auth.proxy]\nenabled = true\nheader_name = X-WEBAUTH-USER\nauto_sign_up = true",
          "style": {
            "fontSize": 12,
            "color": "#2196F3",
            "padding": "8px",
            "backgroundColor": "#e3f2fd",
            "borderRadius": "4px",
            "whiteSpace": "pre-line",
            "fontFamily": "monospace"
          },
          "hidden": "!data.grafanaEnabled || !data.grafanaLangSyncEnabled"
        },
        "grafanaSsoEnabled": {
          "type": "checkbox",
          "label": "SSO via nginx auth_request",
          "sm": 12,
          "default": false,
          "help": "nginx auth_request forwards ioBroker session to Grafana — users auto-login to Grafana iframe",
          "hidden": "!data.grafanaEnabled"
        },
        "_ssoInfo": {
          "type": "staticText",
          "text": "ℹ️ Requires nginx to be configured with auth_request.\nAdd to nginx grafana location:\n  auth_request /mywebui-auth-check;\n  auth_request_set $auth_user $upstream_http_x_user;\n  proxy_set_header X-WEBAUTH-USER $auth_user;",
          "style": {
            "fontSize": 12,
            "color": "#2196F3",
            "padding": "8px",
            "backgroundColor": "#e3f2fd",
            "borderRadius": "4px",
            "whiteSpace": "pre-line",
            "fontFamily": "monospace"
          },
          "hidden": "!data.grafanaEnabled || !data.grafanaSsoEnabled"
        }
      }
    }
  }
}
