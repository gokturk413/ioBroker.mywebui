{"properties": {"label": {"type": "string", "default": "Theme"}}, "settings": {"width": "170px", "height": "40px"}, "html": "<div id=\"wrap\" class=\"ts\"><span id=\"lbl\" class=\"ts-lbl\"></span><select id=\"sel\" class=\"ts-sel\"></select></div>", "style": ":host{display:inline-block;font-family:'Segoe UI',Roboto,sans-serif;}\n.ts{display:flex;align-items:center;gap:8px;}\n.ts-lbl{font-size:13px;color:var(--ui-text,#e2e6ec);}\n.ts-sel{font-size:13px;padding:6px 12px;border-radius:6px;-webkit-backdrop-filter:var(--ui-backdrop,none);backdrop-filter:var(--ui-backdrop,none);background:var(--ui-input,#3a3f4b);color:var(--ui-text,#e2e6ec);border:1px solid var(--ui-border,#3b4250);cursor:pointer;outline:none;}\n.ts-sel:focus{border-color:var(--accent,#2680eb);}", "script": "function render(instance){\n    const lbl=instance._getDomElement('lbl'), sel=instance._getDomElement('sel');\n    if(lbl){ lbl.textContent=instance.label||''; lbl.style.display=instance.label?'':'none'; }\n    if(!sel) return;\n    const api=window.mywebuiTheme;\n    const themes=api?api.list():[{name:'dark',label:'Dark'},{name:'light',label:'Light'}];\n    const cur=api?api.current():'dark';\n    sel.innerHTML=themes.map(t=>'<option value=\"'+t.name+'\"'+(t.name===cur?' selected':'')+'>'+t.label+'</option>').join('');\n    sel.onchange=()=>{ try{ window.mywebuiTheme && window.mywebuiTheme.apply(sel.value); }catch(e){} };\n}\nexport function init(instance){\n    try{instance._bindingsRefresh&&instance._bindingsRefresh?.();}catch(e){}\n    try{instance._assignEvent('label-changed',()=>render(instance));}catch(e){}\n    render(instance);\n    instance.__onTheme=()=>{ const sel=instance._getDomElement('sel'); const api=window.mywebuiTheme; if(sel&&api) sel.value=api.current(); };\n    window.addEventListener('webui-theme-changed', instance.__onTheme);\n}\nexport function connectedCallback(instance){ render(instance); }\nexport function disconnectedCallback(instance){ try{ window.removeEventListener('webui-theme-changed', instance.__onTheme); }catch(e){} }\n"}