{
  "properties": {
    "instances": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "screen": {
      "type": "screen",
      "default": ""
    }
  },
  "settings": {
    "width": "190px",
    "height": "40px"
  },
  "html": "<button id=\"b\" class=\"rb\" type=\"button\"><span class=\"dot\"></span><span class=\"tx\"><span id=\"lb\" class=\"lb\"></span><span id=\"nm\" class=\"nm\"></span></span></button>",
  "style": ":host{display:block;box-sizing:border-box;font-family:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;color:var(--ui-text,#e6ebf2)}\n*{box-sizing:border-box}\n.mono{font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace;font-variant-numeric:tabular-nums}\n.t-ok{--tone:var(--ui-ok,#3ccf7a)} .t-warn{--tone:var(--ui-warn,#f2a531)} .t-error{--tone:var(--ui-error,#ff5a6a)}\n.t-info{--tone:var(--ui-info,#57b6ff)} .t-off{--tone:var(--ui-dim,#9aa5b5)}\n@media (prefers-reduced-motion: reduce){*{animation:none!important}}\n:host{display:inline-block;height:100%}\n.rb{display:inline-flex;align-items:center;gap:10px;height:100%;max-width:100%;padding:4px 14px 4px 12px;border-radius:999px;cursor:default;font:inherit;color:inherit;\n  background:color-mix(in srgb,var(--tone) 12%,transparent);border:1px solid color-mix(in srgb,var(--tone) 50%,var(--ui-border,#3b4250))}\n.rb.link{cursor:pointer}.rb.link:hover{background:color-mix(in srgb,var(--tone) 20%,transparent)}\n.rb:focus-visible{outline:2px solid var(--accent,#57b6ff);outline-offset:2px}\n.dot{width:10px;height:10px;border-radius:50%;flex:none;background:var(--tone);box-shadow:0 0 0 3px color-mix(in srgb,var(--tone) 25%,transparent)}\n.rb.t-error .dot{animation:rdPulse 1.2s ease-in-out infinite}\n@keyframes rdPulse{50%{box-shadow:0 0 0 6px color-mix(in srgb,var(--tone) 8%,transparent)}}\n.tx{display:flex;flex-direction:column;line-height:1.15;min-width:0;text-align:left}\n.lb{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--ui-dim,#9aa5b5);white-space:nowrap}\n.nm{font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n",
  "script": "const RD_I18N = {\n    en: { title: 'Redundancy', primary: 'Primary', noPrimary: 'No primary server', split: 'More than one primary: {list}',\n          since: 'since {time} ({ago})', epoch: 'epoch {n}', server: 'Server', watchdog: 'Watchdog', running: 'running',\n          stoppedWd: 'not running', peer: 'Peer', links: 'Links', licence: 'Licence', valid: 'valid', invalid: 'not valid',\n          maint: 'Maintenance', maintUntil: 'until {time}', vip: 'Cluster address', vipOn: '{a} on {h}', vipNone: '{a}: no server holds it',\n          screen: 'This screen', viaVip: 'via the cluster address {a} (server {h})', direct: 'from server {h}',\n          directStandby: 'from {h}, a standby: values may be old and writes do not reach the database',\n          offline: 'No connection to the server', last: 'Last switchover', never: 'none recorded', by: 'by {who}',\n          events: 'Events', noInst: 'No redundancy adapter instance found', loading: 'Reading…',\n          roles: { primary: 'primary', standby: 'standby', fenced: 'fenced', offline: 'offline', stopped: 'stopped', down: 'not running' } },\n    az: { title: 'Redundancy', primary: 'Əsas server', noPrimary: 'Əsas server yoxdur', split: 'Birdən çox əsas server: {list}',\n          since: '{time} saatından bəri ({ago})', epoch: 'epoch {n}', server: 'Server', watchdog: 'Watchdog', running: 'işləyir',\n          stoppedWd: 'işləmir', peer: 'Qonşu', links: 'Xətlər', licence: 'Lisenziya', valid: 'keçərli', invalid: 'keçərsiz',\n          maint: 'Texniki xidmət', maintUntil: '{time} saatına qədər', vip: 'Klaster ünvanı', vipOn: '{a} → {h}', vipNone: '{a}: heç bir serverdə deyil',\n          screen: 'Bu ekran', viaVip: 'klaster ünvanı {a} ilə (server {h})', direct: '{h} serverindən',\n          directStandby: '{h} serverindən, o ehtiyatdadır: dəyərlər köhnə ola bilər, yazmalar bazaya çatmır',\n          offline: 'Serverlə əlaqə yoxdur', last: 'Son keçid', never: 'qeyd yoxdur', by: '{who} tərəfindən',\n          events: 'Hadisələr', noInst: 'Redundancy adapter instance-ı tapılmadı', loading: 'Oxunur…',\n          roles: { primary: 'əsas', standby: 'ehtiyat', fenced: 'təcrid', offline: 'oflayn', stopped: 'dayanıb', down: 'işləmir' } },\n    ru: { title: 'Резервирование', primary: 'Основной', noPrimary: 'Нет основного сервера', split: 'Больше одного основного: {list}',\n          since: 'с {time} ({ago})', epoch: 'эпоха {n}', server: 'Сервер', watchdog: 'Watchdog', running: 'работает',\n          stoppedWd: 'не работает', peer: 'Сосед', links: 'Связи', licence: 'Лицензия', valid: 'действует', invalid: 'не действует',\n          maint: 'Обслуживание', maintUntil: 'до {time}', vip: 'Адрес кластера', vipOn: '{a} на {h}', vipNone: '{a}: ни на одном сервере',\n          screen: 'Этот экран', viaVip: 'через адрес кластера {a} (сервер {h})', direct: 'с сервера {h}',\n          directStandby: 'с {h}, это резерв: значения могут быть старыми, записи не доходят до базы',\n          offline: 'Нет связи с сервером', last: 'Последнее переключение', never: 'не было', by: '{who}',\n          events: 'События', noInst: 'Экземпляр адаптера redundancy не найден', loading: 'Чтение…',\n          roles: { primary: 'основной', standby: 'резерв', fenced: 'изолирован', offline: 'офлайн', stopped: 'остановлен', down: 'не работает' } },\n    de: { title: 'Redundanz', primary: 'Primär', noPrimary: 'Kein primärer Server', split: 'Mehr als ein primärer Server: {list}',\n          since: 'seit {time} ({ago})', epoch: 'Epoche {n}', server: 'Server', watchdog: 'Watchdog', running: 'läuft',\n          stoppedWd: 'läuft nicht', peer: 'Gegenstelle', links: 'Verbindungen', licence: 'Lizenz', valid: 'gültig', invalid: 'ungültig',\n          maint: 'Wartung', maintUntil: 'bis {time}', vip: 'Cluster-Adresse', vipOn: '{a} auf {h}', vipNone: '{a}: kein Server hält sie',\n          screen: 'Dieser Bildschirm', viaVip: 'über die Cluster-Adresse {a} (Server {h})', direct: 'von Server {h}',\n          directStandby: 'von {h}, einem Standby: Werte können alt sein, Schreibvorgänge erreichen die Datenbank nicht',\n          offline: 'Keine Verbindung zum Server', last: 'Letzte Umschaltung', never: 'keine', by: 'durch {who}',\n          events: 'Ereignisse', noInst: 'Keine Instanz des Redundancy-Adapters gefunden', loading: 'Wird gelesen…',\n          roles: { primary: 'primär', standby: 'Standby', fenced: 'abgeschottet', offline: 'offline', stopped: 'gestoppt', down: 'läuft nicht' } },\n    tr: { title: 'Yedeklilik', primary: 'Birincil', noPrimary: 'Birincil sunucu yok', split: 'Birden fazla birincil: {list}',\n          since: '{time} itibarıyla ({ago})', epoch: 'epoch {n}', server: 'Sunucu', watchdog: 'Watchdog', running: 'çalışıyor',\n          stoppedWd: 'çalışmıyor', peer: 'Eş', links: 'Bağlantılar', licence: 'Lisans', valid: 'geçerli', invalid: 'geçersiz',\n          maint: 'Bakım', maintUntil: '{time} kadar', vip: 'Küme adresi', vipOn: '{a} → {h}', vipNone: '{a}: hiçbir sunucuda değil',\n          screen: 'Bu ekran', viaVip: 'küme adresi {a} üzerinden (sunucu {h})', direct: '{h} sunucusundan',\n          directStandby: '{h} sunucusundan, bir yedek: değerler eski olabilir, yazmalar veritabanına ulaşmaz',\n          offline: 'Sunucuyla bağlantı yok', last: 'Son geçiş', never: 'kayıt yok', by: '{who} tarafından',\n          events: 'Olaylar', noInst: 'Redundancy adaptörü örneği bulunamadı', loading: 'Okunuyor…',\n          roles: { primary: 'birincil', standby: 'yedek', fenced: 'yalıtılmış', offline: 'çevrim dışı', stopped: 'durdu', down: 'çalışmıyor' } },\n};\nconst RD_FIELDS = ['info.connection', 'role', 'watchdogHost', 'epoch', 'peer', 'lastSwitch', 'events', 'maintenanceUntil', 'links', 'license.valid', 'watchdogConfig', 'vip'];\nconst RD_ROLE_TONE = { primary: 'ok', standby: 'info', fenced: 'error', offline: 'off', stopped: 'off', down: 'off' };\n\nfunction rdLang(){ const l = (window.IOB && window.IOB.language) || 'en'; return RD_I18N[l] ? l : 'en'; }\nexport function rdT(key, vars){\n    const d = RD_I18N[rdLang()];\n    let s = key.startsWith('roles.') ? (d.roles[key.slice(6)] ?? RD_I18N.en.roles[key.slice(6)] ?? key.slice(6)) : (d[key] ?? RD_I18N.en[key] ?? key);\n    if(vars) s = s.replace(/\\{(\\w+)\\}/g, (m, k) => vars[k] ?? '');\n    return s;\n}\nexport function rdJson(v, d){ if(v == null || v === '') return d; if(typeof v === 'object') return v; try{ return JSON.parse(v); }catch(e){ return d; } }\nconst rdPad = (n) => String(n).padStart(2, '0');\nexport function rdTime(t){\n    if(!t) return '';\n    const d = new Date(t);\n    const s = rdPad(d.getHours()) + ':' + rdPad(d.getMinutes()) + ':' + rdPad(d.getSeconds());\n    return d.toDateString() === new Date().toDateString() ? s : rdPad(d.getDate()) + '.' + rdPad(d.getMonth() + 1) + ' ' + s;\n}\nexport function rdAgo(t, now){\n    const s = Math.max(0, Math.round((now - t) / 1000));\n    if(s < 60) return s + ' s';\n    if(s < 3600) return Math.floor(s / 60) + ' min';\n    if(s < 86400) return Math.floor(s / 3600) + ' h ' + Math.floor(s % 3600 / 60) + ' min';\n    return Math.floor(s / 86400) + ' d';\n}\n// \"192.168.64.10/24\" (the VIP carries its prefix), \"192.168.64.11:6379\", \"[fe80::1]:8082\" → the bare address\nconst rdIp = (addr) => { const t = String(addr || '').trim().replace(/\\/\\d+$/, ''); return t.startsWith('[') ? t.slice(1, t.indexOf(']')) : (t.split(':').length === 2 ? t.split(':')[0] : t); };\n\n/**\n * What the states say, as one picture. `data[ns]` holds the values of `ns`'s RD_FIELDS plus\n * `alive` (system.adapter.ns.alive) and `host` (its common.host); `online` is IOB.online,\n * `page` the host name this screen was loaded from, `server` web.0's own answer\n * ({ host, role }, the gateway's serverInfo) or null.\n */\nexport function rdModel(list, data, online, page, now, server){\n    let hosts = [];\n    let vip = null;\n    const nodes = list.map((ns) => {\n        const m = data[ns] || {};\n        const cfg = rdJson(m.watchdogConfig, null);\n        if(cfg && Array.isArray(cfg.hosts) && cfg.hosts.length > hosts.length) hosts = cfg.hosts;\n        const v = rdJson(m.vip, null);\n        let role = String(m.role || 'offline');\n        // a server whose instance is gone keeps its last states: \"primary\" from before it died\n        if(m.alive !== true) role = 'down';\n        const links = rdJson(m.links, []);\n        const n = {\n            ns, host: m.host || '', name: String(m.watchdogHost || m.host || ns), role,\n            watchdog: m['info.connection'] === true, epoch: Number(m.epoch) || 0,\n            peer: role === 'down' ? '' : String(m.peer || ''),\n            links: Array.isArray(links) ? links : [], licence: m['license.valid'] == null ? null : m['license.valid'] === true,\n            maintUntil: Number(m.maintenanceUntil) || 0, vip: v, lastSwitch: rdJson(m.lastSwitch, null),\n            events: rdJson(m.events, []),\n        };\n        if(v && v.address){\n            vip = vip || { address: rdIp(v.address), held: null, error: '' };\n            if(v.held === true) vip.held = n.name;\n            if(v.error && !vip.error) vip.error = n.name + ': ' + v.error;\n        }\n        return n;\n    });\n    const primaries = nodes.filter(n => n.role === 'primary');\n    const primary = primaries.length === 1 ? primaries[0] : null;\n    const epoch = Math.max(0, ...nodes.map(n => n.epoch));\n\n    // every event once, newest first, with the server that told it\n    const seen = new Set();\n    const events = [];\n    for(const n of nodes) for(const e of Array.isArray(n.events) ? n.events : []){\n        if(!e || typeof e !== 'object') continue;\n        const k = e.t + '|' + e.event + '|' + n.name;\n        if(seen.has(k)) continue;\n        seen.add(k);\n        events.push({ ...e, node: n.name });\n    }\n    events.sort((a, b) => (b.t || 0) - (a.t || 0));\n    // a switchover names the Valkey masters (\"192.168.64.13:6379\"): the server names instead\n    const nameOf = (x) => { if(x == null || x === '') return x; const h = hosts.find(h => h.name === x || (h.redis && rdIp(h.redis) === rdIp(x))); return h ? h.name : x; };\n    const named = (e) => ('from' in e || 'to' in e) ? { ...e, from: nameOf(e.from), to: nameOf(e.to) } : e;\n    for(let i = 0; i < events.length; i++) events[i] = named(events[i]);\n\n    // the last change of primary: a planned switchover or a failover\n    let last = null;\n    for(const n of nodes) if(n.lastSwitch && n.lastSwitch.t && (!last || n.lastSwitch.t > last.t)) last = named({ kind: 'switchover', ...n.lastSwitch });\n    const fo = events.find(e => e.event === 'failover-done' || e.event === 'failover');\n    if(fo && (!last || fo.t > last.t)) last = { kind: fo.event, ...fo };\n    // since when the primary is primary: its own newest \"role → primary\"\n    let since = 0;\n    if(primary){\n        const r = events.find(e => e.event === 'role' && e.role === 'primary' && e.node === primary.name);\n        since = r ? r.t : (last && last.t) || 0;\n    }\n\n    // which server this screen talks to: web.0 says so itself. The page's URL does not tell\n    // (a proxy on every server may forward to the cluster address), so without that answer only\n    // \"via the cluster address\" is said, and never an alarm\n    let served = null;\n    const viaVip = !!(vip && vip.address && rdIp(vip.address) === rdIp(page));\n    if(server && server.host){\n        const node = nodes.find(n => n.host === server.host) || null;\n        served = { via: viaVip ? 'vip' : 'direct', node, host: server.host, standby: server.role === 'standby' || !!(node && node.role !== 'primary') };\n    } else if(viaVip) served = { via: 'vip', node: primary, host: '', standby: false };\n\n    const problems = [];\n    let tone = 'ok';\n    const rank = { ok: 0, warn: 1, error: 2 };\n    const bad = (t, text) => { problems.push(text); if(rank[t] > rank[tone]) tone = t; };\n    if(!online) bad('error', rdT('offline'));\n    if(!nodes.length) bad('warn', rdT('noInst'));\n    else if(!primaries.length) bad('error', rdT('noPrimary'));\n    else if(primaries.length > 1) bad('error', rdT('split', { list: primaries.map(n => n.name).join(', ') }));\n    if(served && served.standby) bad('error', rdT('directStandby', { h: served.node ? served.node.name : served.host }));\n    for(const n of nodes){\n        if(n.role !== 'primary' && n.role !== 'standby') bad(n.role === 'fenced' ? 'error' : 'warn', n.name + ': ' + rdT('roles.' + n.role));\n        else if(!n.watchdog) bad('warn', n.name + ': ' + rdT('watchdog') + ' ' + rdT('stoppedWd'));\n        if(n.peer && n.peer !== 'Ok') bad('warn', n.name + ': ' + rdT('peer') + ' ' + n.peer);\n        const lost = n.links.filter(l => l && l.lost);\n        if(lost.length && n.role !== 'down') bad('warn', n.name + ': ' + rdT('links') + ' ' + lost.map(l => l.name).join(', '));\n        if(n.licence === false) bad('warn', n.name + ': ' + rdT('licence') + ' ' + rdT('invalid'));\n        if(n.maintUntil > now) bad('warn', n.name + ': ' + rdT('maint') + ' ' + rdT('maintUntil', { time: rdTime(n.maintUntil) }));\n    }\n    if(vip && vip.address && !vip.held) bad('warn', rdT('vipNone', { a: vip.address }));\n    if(vip && vip.error) bad('warn', rdT('vip') + ' ' + vip.error);\n    return { nodes, primary, primaries, epoch, events, last, since, vip, served, tone, problems, online };\n}\n\n/** One line for an event: what happened, in the watchdog's own words. */\nexport function rdEventText(e){\n    // eslint-disable-next-line no-unused-vars\n    const { t, event, node, type, ...rest } = e;\n    if(event === 'role') return rdT('roles.' + rest.role) || String(rest.role);\n    if(event === 'switchover') return (rest.from || '?') + ' → ' + (rest.to || '?') + (rest.by ? ' · ' + rest.by : '') + (rest.reason ? ' · ' + rest.reason : '');\n    if(event === 'switchover-failed') return '→ ' + (rest.to || '?') + ' · ' + (rest.error || '');\n    if(event === 'fence') return String(rest.why || '');\n    if(event === 'alarm' || event === 'licence-event') return String(rest.what || '');\n    if(event === 'instance') return (rest.id || '') + ' ' + (rest.state || '');\n    if(event === 'lease') return 'epoch ' + (rest.taken ?? '');\n    if(event === 'vip' && rest.address) return rest.address + (rest.held === true ? ' ↑' : rest.held === false ? ' ↓' : '') + (rest.error ? ' · ' + rest.error : '');\n    const parts = Object.entries(rest).filter(([, v]) => v !== '' && v != null && typeof v !== 'object').map(([k, v]) => k + '=' + v);\n    return parts.join(' ').slice(0, 200);\n}\nconst RD_EVENT_TONE = { fence: 'error', 'failover-failed': 'error', 'switchover-failed': 'error', alarm: 'warn', 'api-error': 'warn', switchover: 'info', 'failover-done': 'info', failover: 'warn', unfence: 'ok' };\nexport function rdEventTone(e){ return e.event === 'role' ? (RD_ROLE_TONE[e.role] || 'off') : (RD_EVENT_TONE[e.event] || 'off'); }\n\n/**\n * Reads and follows the states of the instances; calls `onChange()` (batched) whenever\n * something changed. Returns the function that stops it. `instance.__rd` holds the data.\n */\nexport function rdStart(instance, onChange){\n    const rd = instance.__rd = { list: null, data: {}, subs: [], stopped: false, error: '', server: null };\n    let soon = 0;\n    const changed = () => { if(!soon) soon = requestAnimationFrame(() => { soon = 0; if(!rd.stopped) onChange(); }); };\n    const IOB = window.IOB;\n    const follow = (ns, key, id) => {\n        const set = (s) => { (rd.data[ns] = rd.data[ns] || {})[key] = s ? s.val : null; changed(); };\n        const cb = (_id, s) => set(s);\n        rd.subs.push([id, cb]);\n        try{ IOB.subscribeState(id, cb); }catch(e){}\n        return Promise.resolve(IOB.getState(id)).then(set, () => {});\n    };\n    const go = async () => {\n        if(!IOB || !IOB.connection) return;\n        try{\n            let list = String(instance.instances || '').split(/[\\s,;]+/).filter(Boolean).map(s => s.replace(/^system\\.adapter\\./, ''));\n            const objs = {};\n            if(!list.length){\n                const view = await IOB.connection.getObjectView('system.adapter.redundancy.', 'system.adapter.redundancy.香', 'instance');\n                for(const [id, o] of Object.entries(view || {})) objs[id.replace(/^system\\.adapter\\./, '')] = o;\n                list = Object.keys(objs).sort((a, b) => Number(a.split('.').pop()) - Number(b.split('.').pop()));\n            } else {\n                await Promise.all(list.map(ns => Promise.resolve(IOB.getObject('system.adapter.' + ns)).then(o => { objs[ns] = o; }, () => {})));\n            }\n            if(rd.stopped) return;\n            rd.list = list;\n            rd.error = '';\n            for(const ns of list) (rd.data[ns] = rd.data[ns] || {}).host = (objs[ns] && objs[ns].common && objs[ns].common.host) || '';\n            changed();\n            await Promise.all(list.flatMap(ns => [\n                ...RD_FIELDS.map(f => follow(ns, f, ns + '.' + f)),\n                follow(ns, 'alive', 'system.adapter.' + ns + '.alive'),\n            ]));\n        }catch(e){\n            rd.error = String(e && e.message || e);\n            changed();\n        }\n    };\n    // which server answers this page (it changes only with a new connection)\n    const ask = () => {\n        if(!IOB || typeof IOB.serverCall !== 'function') return;\n        let t = 0;\n        Promise.race([IOB.serverCall('serverInfo', {}), new Promise((_, no) => { t = setTimeout(() => no(new Error('timeout')), 5000); })])\n            .then((r) => { if(r && typeof r.host === 'string' && r.host){ rd.server = { host: r.host, role: r.role ?? null }; changed(); } }, () => {})\n            .finally(() => clearTimeout(t));\n    };\n    // after a reconnect: maybe another server; the instances if not found yet\n    const again = () => { if(rd.stopped) return; ask(); if(!rd.list) go(); };\n    window.addEventListener('iob-reconnected', again);\n    // the times (\"since 4 min\") and IOB.online move without a state change\n    const tick = setInterval(changed, 1000);\n    go();\n    ask();\n    return () => {\n        rd.stopped = true;\n        clearInterval(tick);\n        if(soon) cancelAnimationFrame(soon);\n        window.removeEventListener('iob-reconnected', again);\n        for(const [id, cb] of rd.subs){ try{ IOB.unsubscribeState(id, cb); }catch(e){} }\n        rd.subs = [];\n    };\n}\nexport function rdCurrent(instance){\n    const rd = instance.__rd;\n    const online = !window.IOB || window.IOB.online !== false;\n    return rd && rd.list ? rdModel(rd.list, rd.data, online, location.hostname, Date.now(), rd.server) : null;\n}\n// the picture changed: other things on the screen can follow it\nexport function rdAnnounce(instance, m){\n    const key = (m.primary ? m.primary.name : '') + '|' + m.tone;\n    if(instance.__rdKey === key) return;\n    instance.__rdKey = key;\n    instance.dataset.tone = m.tone;\n    if(m.primary) instance.dataset.primary = m.primary.name; else delete instance.dataset.primary;\n    instance.dispatchEvent(new CustomEvent('redundancy-change', { bubbles: true, composed: true,\n        detail: { primary: m.primary ? m.primary.name : null, primaryHost: m.primary ? m.primary.host : null, tone: m.tone, problems: m.problems, epoch: m.epoch } }));\n}\nconst el = (tag, cls, text) => { const e = document.createElement(tag); if(cls) e.className = cls; if(text != null) e.textContent = text; return e; };\nexport function init(instance){\n    const $ = (id) => instance._getDomElement(id);\n    const b = $('b');\n    const draw = () => {\n        b.classList.toggle('link', !!instance.screen);\n        const m = rdCurrent(instance);\n        $('lb').textContent = instance.label || rdT('primary');\n        if(!m){ b.className = 'rb t-off' + (instance.screen ? ' link' : ''); $('nm').textContent = '…'; b.title = instance.__rd && instance.__rd.error || ''; return; }\n        rdAnnounce(instance, m);\n        b.className = 'rb t-' + m.tone + (instance.screen ? ' link' : '');\n        $('nm').textContent = !m.online ? rdT('offline') : m.primary ? m.primary.name + (m.primary.host && m.primary.host !== m.primary.name ? ' · ' + m.primary.host : '')\n            : m.primaries.length > 1 ? m.primaries.map(n => n.name).join(' + ') : rdT('noPrimary');\n        const lines = m.nodes.map(n => n.name + ': ' + rdT('roles.' + n.role));\n        if(m.since) lines.push(rdT('since', { time: rdTime(m.since), ago: rdAgo(m.since, Date.now()) }));\n        b.title = [...lines, ...m.problems].join('\\n');\n        b.setAttribute('aria-label', $('lb').textContent + ': ' + $('nm').textContent);\n    };\n    b.addEventListener('click', () => {\n        if(instance.screen && window.IOB && window.IOB.changeView) window.IOB.changeView.emit(instance.screen);\n        instance.dispatchEvent(new CustomEvent('badgeclick', { bubbles: true, composed: true }));\n    });\n    const restart = () => { if(instance.__rdStop) instance.__rdStop(); instance.__rdStop = rdStart(instance, draw); draw(); };\n    for(const p of ['label', 'screen']) instance._assignEvent(p + '-changed', draw);\n    instance._assignEvent('instances-changed', restart);\n    restart();\n}\nexport function disconnectedCallback(instance){ try{ instance.__rdStop && instance.__rdStop(); }catch(e){} instance.__rdStop = null; }\n"
}