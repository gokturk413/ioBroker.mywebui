{
  "properties": {
    "signal": {
      "type": "signal",
      "default": ""
    },
    "buttons": {
      "type": "string",
      "default": "[{\"label\": \"ON\", \"value\": true, \"tone\": \"ok\"}, {\"label\": \"OFF\", \"value\": false, \"tone\": \"off\"}, {\"label\": \"RESET\", \"value\": true, \"tone\": \"warn\", \"momentary\": true, \"signal\": \"\"}]"
    }
  },
  "settings": {
    "width": "300px",
    "height": "44px"
  },
  "html": "<div id=\"g\" class=\"cmdg\" role=\"group\"></div>",
  "style": ":host{display:block;box-sizing:border-box;font-family:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;color:var(--ui-text,#e6ebf2);--db-glow:var(--ui-glow,#ffd36a)}\n*{box-sizing:border-box}\n.mono{font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace;font-variant-numeric:tabular-nums}\n@media (prefers-reduced-motion: reduce){*{animation:none!important}}\n.t-ok{--tone:var(--ui-ok,#3ccf7a)} .t-warn{--tone:var(--ui-warn,#f2a531)} .t-error{--tone:var(--ui-error,#ff5a6a)}\n.t-info{--tone:var(--ui-info,#57b6ff)} .t-accent{--tone:var(--accent,#57b6ff)} .t-glow{--tone:var(--db-glow)} .t-off{--tone:var(--ui-dim,#9aa5b5)}\n.cmdg{height:100%;display:inline-flex;border-radius:10px;overflow:hidden;border:1px solid var(--ui-border,#4a5262)}\nbutton{font:600 15px 'IBM Plex Sans','Segoe UI',sans-serif;letter-spacing:.04em;padding:0 22px;border:0;border-right:1px solid var(--ui-border,#4a5262);background:var(--ui-surface-2,#3a414d);color:var(--ui-dim,#9aa5b5);cursor:pointer}\nbutton:last-child{border-right:0}\nbutton.cur{background:linear-gradient(180deg,color-mix(in srgb,var(--tone) 100%,#fff 10%),color-mix(in srgb,var(--tone) 80%,#000));color:#fff}\nbutton.mom{color:var(--tone)}\nbutton.mom.flash,button.mom:active{background:linear-gradient(180deg,color-mix(in srgb,var(--tone) 100%,#fff 15%),color-mix(in srgb,var(--tone) 80%,#000));color:#1d1404}\nbutton:focus-visible{outline:2px solid var(--accent,#57b6ff);outline-offset:-3px}\n",
  "script": "function dbSubscribe(instance, key, id, onVal){\n    dbUnsub(instance, key);\n    if(!id || !window.IOB) return;\n    instance.__dbSubs = instance.__dbSubs || {};\n    const cb = function(_i, s){ onVal(s ? s.val : null); };\n    instance.__dbSubs[key] = [id, cb];\n    try{ window.IOB.subscribeState(id, cb); }catch(e){}\n    try{ window.IOB.getState(id).then(function(s){ onVal(s ? s.val : null); }).catch(function(){}); }catch(e){}\n    // read quality knows this state (badge on the control when the value cannot be trusted)\n    try{ instance.__dbRq = instance.__dbRq || {}; instance.__dbRq[key] = window.IOB.watchReadQuality && window.IOB.watchReadQuality(instance, id, { prop: key, twoWay: true }); }catch(e){}\n}\nfunction dbUnsub(instance, key){\n    const p = instance.__dbSubs && instance.__dbSubs[key];\n    if(p){ try{ window.IOB.unsubscribeState(p[0], p[1]); }catch(e){} delete instance.__dbSubs[key]; }\n    const r = instance.__dbRq && instance.__dbRq[key];\n    if(typeof r === 'function'){ try{ r(); }catch(e){} }\n    if(instance.__dbRq) delete instance.__dbRq[key];\n}\nfunction dbUnsubAll(instance){ for(const k of Object.keys(instance.__dbSubs || {})) dbUnsub(instance, k); }\n// a write through IOB.setState: Confirm & Protect may ask first; cancelled = nothing written\nfunction dbWrite(instance, id, val, onCancel){\n    if(!id || !window.IOB) return Promise.resolve(false);\n    return Promise.resolve(window.IOB.setState(id, val, false, { feedback: instance })).then(function(){ return true; }, function(e){\n        if(e && e.cancelled){ if(onCancel) onCancel(); }\n        else console.warn('[dashboard] write failed', id, e);\n        return false;\n    });\n}\nfunction dbBool(v){ return v === true || v === 1 || v === 'true' || v === '1' || v === 'on'; }\nfunction dbNum(v, d){ const n = Number(v); return isFinite(n) ? n : d; }\nexport function parseButtons(text){\n    try{ const a = JSON.parse(text || '[]'); return Array.isArray(a) ? a.filter(b => b && b.label != null) : []; }catch(e){ return []; }\n}\nexport function sameValue(a, b){\n    if(a === b) return true;\n    if(a == null || b == null) return false;\n    if(typeof a === 'boolean' || typeof b === 'boolean') return dbBool(a) === dbBool(b);\n    return String(a) === String(b);\n}\nexport function init(instance){\n    const g = instance._getDomElement('g');\n    let current;\n    const paint = () => {\n        for(const b of g.children){ const d = b.__def; b.classList.toggle('cur', !d.momentary && sameValue(current, d.value)); b.setAttribute('aria-pressed', String(b.classList.contains('cur'))); }\n    };\n    const build = () => {\n        g.textContent = '';\n        for(const d of parseButtons(instance.buttons)){\n            const b = document.createElement('button');\n            b.type = 'button'; b.textContent = d.label; b.__def = d;\n            b.className = 't-' + (d.tone || 'accent') + (d.momentary ? ' mom' : '');\n            b.addEventListener('click', async () => {\n                const id = d.signal || instance.signal;\n                if(d.momentary){\n                    b.classList.add('flash'); setTimeout(() => b.classList.remove('flash'), 400);\n                    // a pulse: the value, then back (true → false, 1 → 0)\n                    if(await dbWrite(instance, id, d.value)) setTimeout(() => dbWrite(instance, id, typeof d.value === 'boolean' ? !d.value : 0), 500);\n                } else dbWrite(instance, id, d.value);\n            });\n            g.appendChild(b);\n        }\n        paint();\n    };\n    const sub = () => dbSubscribe(instance, 'signal', instance.signal, (v) => { current = v; paint(); });\n    instance._assignEvent('buttons-changed', build);\n    instance._assignEvent('signal-changed', sub);\n    build(); sub();\n}\nexport function disconnectedCallback(instance){ dbUnsubAll(instance); }\n"
}