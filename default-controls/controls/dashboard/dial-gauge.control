{
  "properties": {
    "value": {
      "type": "number",
      "default": 3.2
    },
    "min": {
      "type": "number",
      "default": 0
    },
    "max": {
      "type": "number",
      "default": 6
    },
    "unit": {
      "type": "string",
      "default": "bar"
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "decimals": {
      "type": "number",
      "default": 1
    },
    "zones": {
      "type": "string",
      "default": "0-4:ok,4-5:warn,5-6:error"
    }
  },
  "settings": {
    "width": "120px",
    "height": "120px"
  },
  "html": "<svg id=\"s\" class=\"dial\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"60\" r=\"56\" class=\"face\"/><g id=\"zones\"></g><g id=\"ticks\"></g><line id=\"nd\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"20\" class=\"nd\"/><circle cx=\"60\" cy=\"60\" r=\"5\" class=\"hub\"/><text id=\"v\" x=\"60\" y=\"88\" class=\"vt\">0</text><text id=\"u\" x=\"60\" y=\"101\" class=\"ut\"></text><text id=\"l\" x=\"60\" y=\"74\" class=\"lt\"></text></svg>",
  "style": ":host{display:block;box-sizing:border-box;font-family:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;color:var(--ui-text,#e6ebf2);--db-glow:var(--ui-glow,#ffd36a)}\n*{box-sizing:border-box}\n.mono{font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace;font-variant-numeric:tabular-nums}\n@media (prefers-reduced-motion: reduce){*{animation:none!important}}\n.t-ok{--tone:var(--ui-ok,#3ccf7a)} .t-warn{--tone:var(--ui-warn,#f2a531)} .t-error{--tone:var(--ui-error,#ff5a6a)}\n.t-info{--tone:var(--ui-info,#57b6ff)} .t-accent{--tone:var(--accent,#57b6ff)} .t-glow{--tone:var(--db-glow)} .t-off{--tone:var(--ui-dim,#9aa5b5)}\n.dial{width:100%;height:100%;display:block}\n.face{fill:var(--ui-surface-2,#3a414d);stroke:var(--ui-border,#4a5262);stroke-width:2}\n.tk{stroke:var(--ui-dim,#9aa5b5);stroke-width:1.5}\n.nd{stroke:var(--ui-error,#ff5a6a);stroke-width:2.5;stroke-linecap:round;transition:transform .4s;transform-origin:60px 60px}\n.hub{fill:var(--ui-text,#e6ebf2)}\n.vt{font:600 15px 'IBM Plex Mono',monospace;fill:var(--ui-text,#e6ebf2);text-anchor:middle}\n.ut{font:11px 'IBM Plex Sans',sans-serif;fill:var(--ui-dim,#9aa5b5);text-anchor:middle}\n.lt{font:9px 'IBM Plex Sans',sans-serif;fill:var(--ui-dim,#9aa5b5);text-anchor:middle;letter-spacing:.04em}\n.z{fill:none;stroke-width:6}\n.z.ok{stroke:var(--ui-ok,#3ccf7a)}.z.warn{stroke:var(--ui-warn,#f2a531)}.z.error{stroke:var(--ui-error,#ff5a6a)}.z.info{stroke:var(--ui-info,#57b6ff)}\n",
  "script": "export function parseZones(text){\n    return String(text || '').split(',').map(s => s.trim()).filter(Boolean).map(s => {\n        const m = /^(-?[\\d.]+)\\s*-\\s*(-?[\\d.]+)\\s*:\\s*(\\w+)$/.exec(s);\n        return m ? { from: Number(m[1]), to: Number(m[2]), tone: m[3] } : null;\n    }).filter(Boolean);\n}\nconst A0 = -135, SPAN = 270;\nfunction pt(a, r){ const t = (a - 90) * Math.PI / 180; return [60 + r * Math.cos(t), 60 + r * Math.sin(t)]; }\nfunction arc(a1, a2, r){ const [x1, y1] = pt(a1, r), [x2, y2] = pt(a2, r); return 'M' + x1.toFixed(2) + ' ' + y1.toFixed(2) + ' A' + r + ' ' + r + ' 0 ' + (a2 - a1 > 180 ? 1 : 0) + ' 1 ' + x2.toFixed(2) + ' ' + y2.toFixed(2); }\nexport function init(instance){\n    const $ = (id) => instance._getDomElement(id);\n    const NS = 'http://www.w3.org/2000/svg';\n    const upd = () => {\n        const min = Number(instance.min) || 0, max = Number(instance.max) || 100, span = (max - min) || 1;\n        const ang = (v) => A0 + Math.max(0, Math.min(1, (v - min) / span)) * SPAN;\n        const z = $('zones'); z.textContent = '';\n        for(const zn of parseZones(instance.zones)){ const p = document.createElementNS(NS, 'path'); p.setAttribute('d', arc(ang(zn.from), ang(zn.to), 48)); p.setAttribute('class', 'z ' + zn.tone); z.appendChild(p); }\n        const t = $('ticks'); t.textContent = '';\n        for(let i = 0; i <= 10; i++){ const a = A0 + i * SPAN / 10, [x1, y1] = pt(a, 41), [x2, y2] = pt(a, i % 5 ? 37 : 34); const l = document.createElementNS(NS, 'line'); l.setAttribute('x1', x1); l.setAttribute('y1', y1); l.setAttribute('x2', x2); l.setAttribute('y2', y2); l.setAttribute('class', 'tk'); t.appendChild(l); }\n        const v = Number(instance.value);\n        $('nd').style.transform = 'rotate(' + ang(isFinite(v) ? v : min) + 'deg)';\n        $('v').textContent = isFinite(v) ? v.toFixed(Math.max(0, Number(instance.decimals) || 0)) : '—';\n        $('u').textContent = instance.unit || ''; $('l').textContent = instance.label || '';\n    };\n    for(const p of ['value', 'min', 'max', 'unit', 'label', 'decimals', 'zones']) instance._assignEvent(p + '-changed', upd);\n    upd();\n}\n"
}