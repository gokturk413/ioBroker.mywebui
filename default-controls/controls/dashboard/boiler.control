{
  "properties": {
    "level": {
      "type": "number",
      "default": 55
    },
    "pv": {
      "type": "number",
      "default": 74
    },
    "sp": {
      "type": "number",
      "default": 75
    },
    "heating": {
      "type": "boolean",
      "default": "true"
    },
    "min": {
      "type": "number",
      "default": 0
    },
    "max": {
      "type": "number",
      "default": 100
    },
    "unit": {
      "type": "string",
      "default": "°C"
    },
    "decimals": {
      "type": "number",
      "default": 0
    },
    "liquidColor": {
      "type": "color",
      "default": "#e8453c"
    },
    "showValues": {
      "type": "boolean",
      "default": "true"
    }
  },
  "settings": {
    "width": "330px",
    "height": "260px"
  },
  "html": "<div id=\"b\" class=\"boil\"><svg class=\"vessel\" viewBox=\"0 0 170 250\" aria-hidden=\"true\"><defs><clipPath id=\"vclip\"><rect x=\"35\" y=\"40\" width=\"100\" height=\"160\" rx=\"22\"/></clipPath><linearGradient id=\"steel\" x1=\"0\" x2=\"1\"><stop offset=\"0\" stop-color=\"#5c6573\"/><stop offset=\".45\" stop-color=\"#b9c2ce\"/><stop offset=\"1\" stop-color=\"#4a525e\"/></linearGradient><linearGradient id=\"liq\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop id=\"lq1\" offset=\"0\" stop-color=\"#ff6b5e\"/><stop id=\"lq2\" offset=\"1\" stop-color=\"#b3221b\"/></linearGradient></defs><rect x=\"70\" y=\"14\" width=\"30\" height=\"20\" rx=\"4\" style=\"fill:url(#steel)\"/><rect x=\"32\" y=\"32\" width=\"106\" height=\"176\" rx=\"26\" style=\"fill:url(#steel)\"/><g clip-path=\"url(#vclip)\"><rect x=\"35\" y=\"40\" width=\"100\" height=\"160\" style=\"fill:#1d2128\"/><g id=\"liquid\" transform=\"translate(0,120)\"><path class=\"wave\" d=\"M0 10 Q 25 0 50 10 T 100 10 T 150 10 T 200 10 V 220 H 0 Z\" style=\"fill:url(#liq)\"/></g><rect x=\"44\" y=\"40\" width=\"10\" height=\"160\" style=\"fill:rgba(255,255,255,.12)\"/></g><rect x=\"112\" y=\"60\" width=\"7\" height=\"120\" rx=\"3.5\" style=\"fill:#e8ecf1\"/><rect id=\"thermo\" x=\"113.5\" y=\"100\" width=\"4\" height=\"78\" rx=\"2\" style=\"fill:#ff4d4d\"/><circle cx=\"115.5\" cy=\"184\" r=\"7\" style=\"fill:#ff4d4d;stroke:#e8ecf1;stroke-width:2\"/><circle cx=\"118\" cy=\"56\" r=\"13\" style=\"fill:#e8ecf1;stroke:#7d8693;stroke-width:2\"/><line id=\"needle\" x1=\"118\" y1=\"56\" x2=\"125\" y2=\"50\" style=\"stroke:#222;stroke-width:2\"/><circle cx=\"85\" cy=\"176\" r=\"13\" style=\"fill:#e8ecf1;stroke:#7d8693;stroke-width:2\"/><line x1=\"85\" y1=\"176\" x2=\"80\" y2=\"168\" style=\"stroke:#222;stroke-width:2\"/><rect x=\"40\" y=\"206\" width=\"90\" height=\"34\" rx=\"4\" style=\"fill:#2b3038\"/><g id=\"flame\" class=\"flame\"><path d=\"M70 238 C 62 226 72 220 74 212 C 78 222 84 214 85 204 C 90 216 100 220 97 230 C 104 226 104 236 100 238 Z\" style=\"fill:#ff9a1f\"/><path d=\"M78 238 C 74 230 80 226 82 220 C 86 228 92 228 92 238 Z\" style=\"fill:#ffe066\"/></g></svg><div id=\"vals\" class=\"vals\"><span class=\"pv mono\"><span id=\"pv\"></span><small id=\"u1\"></small></span><span class=\"sp mono\"><span id=\"sp\"></span><small id=\"u2\"></small></span></div></div>",
  "style": ":host{display:block;box-sizing:border-box;font-family:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;color:var(--ui-text,#e6ebf2);--db-glow:var(--ui-glow,#ffd36a)}\n*{box-sizing:border-box}\n.mono{font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace;font-variant-numeric:tabular-nums}\n@media (prefers-reduced-motion: reduce){*{animation:none!important}}\n.t-ok{--tone:var(--ui-ok,#3ccf7a)} .t-warn{--tone:var(--ui-warn,#f2a531)} .t-error{--tone:var(--ui-error,#ff5a6a)}\n.t-info{--tone:var(--ui-info,#57b6ff)} .t-accent{--tone:var(--accent,#57b6ff)} .t-glow{--tone:var(--db-glow)} .t-off{--tone:var(--ui-dim,#9aa5b5)}\n.boil{height:100%;display:flex;align-items:center;gap:12px}\n.vessel{height:100%;max-height:100%;aspect-ratio:170/250;overflow:visible;flex:none}\n.wave{animation:wave 3s ease-in-out infinite}@keyframes wave{50%{transform:translateX(-14px)}}\n.flame{transform-origin:85px 238px;animation:flick .25s ease-in-out infinite alternate}@keyframes flick{to{transform:scaleY(.82) scaleX(1.06)}}\n.vals{display:flex;flex-direction:column;gap:2px}\n.pv{font-size:36px;font-weight:600}.sp{font-size:26px;font-weight:600;color:var(--db-glow)}\n.vals small{font-size:.6em;margin-left:2px}\n.boil.novals .vals{display:none}\n",
  "script": "export function levelY(level){ const l = Math.max(0, Math.min(100, Number(level) || 0)); return 40 + (1 - l / 100) * 150; }\nexport function init(instance){\n    const $ = (id) => instance._getDomElement(id);\n    const yes = (v) => v === true || v === 'true' || v === 1;\n    const upd = () => {\n        const min = Number(instance.min) || 0, max = Number(instance.max) || 100, dec = Math.max(0, Number(instance.decimals) || 0);\n        $('liquid').setAttribute('transform', 'translate(0,' + levelY(instance.level).toFixed(1) + ')');\n        const pv = Number(instance.pv), f = Math.max(0, Math.min(1, ((isFinite(pv) ? pv : min) - min) / ((max - min) || 1)));\n        $('thermo').setAttribute('y', String(180 - f * 110)); $('thermo').setAttribute('height', String(Math.max(2, f * 110)));\n        const ang = (-140 + f * 280) * Math.PI / 180;\n        $('needle').setAttribute('x2', String(118 + 9 * Math.sin(ang))); $('needle').setAttribute('y2', String(56 - 9 * Math.cos(ang)));\n        $('flame').style.display = yes(instance.heating) ? '' : 'none';\n        const c = instance.liquidColor || '#e8453c';\n        $('lq1').setAttribute('stop-color', c); $('lq2').setAttribute('stop-color', c); $('lq2').setAttribute('stop-opacity', '.75');\n        $('pv').textContent = isFinite(pv) ? pv.toFixed(dec) : '—';\n        const sp = Number(instance.sp); $('sp').textContent = isFinite(sp) ? sp.toFixed(dec) : '—';\n        $('u1').textContent = $('u2').textContent = instance.unit || '';\n        $('b').classList.toggle('novals', instance.showValues === false || instance.showValues === 'false');\n    };\n    for(const p of ['level', 'pv', 'sp', 'heating', 'min', 'max', 'unit', 'decimals', 'liquid-color', 'show-values']) instance._assignEvent(p + '-changed', upd);\n    upd();\n}\n"
}