{
  "properties": {
    "count": {
      "type": "number",
      "default": 4
    },
    "screen": {
      "type": "screen",
      "default": ""
    }
  },
  "settings": {
    "width": "40px",
    "height": "40px"
  },
  "html": "<button id=\"b\" class=\"ib\" type=\"button\" aria-label=\"Notifications\"><svg class=\"bi\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 22a2.5 2.5 0 0 0 2.4-2h-4.8A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 0 0-5.5-6.8V3.5a1.5 1.5 0 0 0-3 0v.7A7 7 0 0 0 5 11v5l-2 2v1h18v-1z\"/></svg><span id=\"n\" class=\"bdg mono\"></span></button>",
  "style": ":host{display:block;box-sizing:border-box;font-family:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;color:var(--ui-text,#e6ebf2);--db-glow:var(--ui-glow,#ffd36a)}\n*{box-sizing:border-box}\n.mono{font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace;font-variant-numeric:tabular-nums}\n@media (prefers-reduced-motion: reduce){*{animation:none!important}}\n.t-ok{--tone:var(--ui-ok,#3ccf7a)} .t-warn{--tone:var(--ui-warn,#f2a531)} .t-error{--tone:var(--ui-error,#ff5a6a)}\n.t-info{--tone:var(--ui-info,#57b6ff)} .t-accent{--tone:var(--accent,#57b6ff)} .t-glow{--tone:var(--db-glow)} .t-off{--tone:var(--ui-dim,#9aa5b5)}\n.ib{width:100%;height:100%;border-radius:9px;display:grid;place-items:center;background:transparent;border:0;color:var(--ui-dim,#9aa5b5);cursor:pointer;position:relative}\n.ib:hover{color:var(--ui-text,#e6ebf2)}.bi{width:60%;height:60%}\n.bdg{position:absolute;top:2px;right:2px;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:var(--ui-error,#ff5a6a);color:#fff;font-size:10px;font-weight:700;display:grid;place-items:center}\n.ib:focus-visible{outline:2px solid var(--accent,#57b6ff)}\n",
  "script": "export function init(instance){\n    const $ = (id) => instance._getDomElement(id);\n    const upd = () => { const n = Number(instance.count) || 0; $('n').textContent = n > 99 ? '99+' : String(n); $('n').style.display = n > 0 ? '' : 'none'; };\n    $('b').addEventListener('click', () => {\n        if(instance.screen && window.IOB && window.IOB.changeView) window.IOB.changeView.emit(instance.screen);\n        instance.dispatchEvent(new CustomEvent('bellclick', { bubbles: true, composed: true }));\n    });\n    instance._assignEvent('count-changed', upd);\n    upd();\n}\n"
}