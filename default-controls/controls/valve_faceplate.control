{"html":"<button type=\"button\" bind-css:background-color='{\"signal\":\"{??relativesignalpath}{??valveid}OIN\",\"converter\":{\"false\":\"#342d2d\",\"true\":\"#09dc33\"}}' class=\"button\" @click='{\"name\":\"SetSignalOpen\"}' data-visibility-enabled=\"false\" data-visibility-condition=\"==\" data-visibility-action=\"disable\" style=\"width:86px;height:51px;position:absolute;left:24px;top:140px;opacity:1;transform-origin:53px 27px;transform:rotate(0deg);translate:0px;\">Aç</button>\n<span bind-content:text='{\"signal\":\"??valveid\",\"converter\":{\"10\":\"Valve 10\",\"11\":\"Valve 11\",\"20\":\"Valve 20\",\"21\":\"Valve 21\",\"30\":\"Valve 30\",\"31\":\"Valve 31\"}}' style=\"position:absolute;left:31px;top:18px;width:145px;height:16px;\">hello world</span>\n<span id=\"myrem\" style=\"position:absolute;left:31px;top:96px;width:79px;height:27px;opacity:0;font:bold 20px &quot;Times New Roman&quot;;\">Remote</span>\n<button type=\"button\" bind-css:background-color='{\"signal\":\"{??relativesignalpath}{??valveid}CIN\",\"converter\":{\"false\":\"#342d2d\",\"true\":\"#09dc33\"}}' class=\"button\" @click=\"SetSignalClose\" data-visibility-enabled=\"false\" data-visibility-condition=\"==\" data-visibility-action=\"disable\" style=\"width:86px;height:51px;position:absolute;left:24px;top:208px;opacity:1;transform-origin:52.9334px 26.9333px;\">Bağla</button>\n<button type=\"button\" class=\"button\" @click=\"SetSignalStop\" style=\"width:86px;height:51px;position:absolute;left:24px;top:278px;opacity:1;transform-origin:52.9334px 26.9333px;\">Stop</button>\n<div style=\"height:50px;width:50px;\"></div>\n<span style=\"position:absolute;left:26px;top:348px;\">Açıqdır</span>\n<span style=\"position:absolute;left:26px;top:391px;\">Bağlıdır</span>\n<webui-webui_led_light1 bind-prop:fillcolor=\"??opened\" style=\"position:absolute;left:86px;top:339px;width:43px;height:41px;\"></webui-webui_led_light1>\n<webui-webui_led_light1 bind-prop:fillcolor=\"??closed\" style=\"position:absolute;left:86px;top:384px;width:43px;height:41px;rotate:0deg;\"></webui-webui_led_light1>\n<span bind-content:text=\"??relativesignalpath{??valveid}OIN\" style=\"position:absolute;left:58px;top:67px;width:112px;\">hello world</span>\n","style":":host {\n    background: transparent;\n}\n\n* {\n    box-sizing: border-box;\n}\n.button {\n    position: relative;\n    padding: 20px;\n    width: 200px;\n    -webkit-transition-duration: 0.4s;\n    /* Safari */\n    transition-duration: 0.4s;\n    text-decoration: none;\n    overflow: hidden;\n    cursor: pointer;\n    background-color: grey;\n    color: white;\n}\n\n.button:after {\n    content: \"\";\n    background: #90EE90;\n    display: block;\n    position: absolute;\n    padding-top: 300%;\n    padding-left: 350%;\n    margin-left: -20px!important;\n    margin-top: -120%;\n    opacity: 0;\n    transition: all 0.8s;\n}\n\n.button:active:after {\n    padding: 0;\n    margin: 0;\n    opacity: 1;\n    transition: 0s;\n}\n\n#myrem {\n    font-style: italic;\n    font-size: 20px;\n    font-family: 'Times New Roman', Times, serif;\n    font-weight: bold;\n}\n\n.blinking_live {\n    height: 15px;\n    width: 15px;\n    border-radius: 15px;\n    color: green;\n    animation: blink-live 2s cubic-bezier(0, 0.2, 0.8, 1) infinite;\n}\n\n@keyframes blink-live {\n    0% {\n        opacity: 1.0;\n    }\n\n    50% {\n        opacity: 0.0;\n    }\n\n    100% {\n        opacity: 1.0;\n    }\n}","script":"export function init(instance){\r\n\r\n}\r\n\r\n/**\r\n* SetSignalOpen - 'click' event of <button>\r\n* @param {PointerEvent} event\r\n* @param {Element} eventRaisingElement\r\n* @param {ShadowRoot} shadowRoot\r\n* @param {BaseScreenViewerAndControl} instance\r\n* @param {Object.<string, *>} parameters\r\n*/\r\nexport function SetSignalOpen(event, eventRaisingElement, shadowRoot, instance, parameters) {\r\n    window.IOB.setState(instance.relativesignalpath + instance.valveid + \"OIN\",true);\r\n}\r\n\r\n/**\r\n* SetSignalClose - 'click' event of <button>\r\n* @param {PointerEvent} event\r\n* @param {Element} eventRaisingElement\r\n* @param {ShadowRoot} shadowRoot\r\n* @param {BaseScreenViewerAndControl} instance\r\n* @param {Object.<string, *>} parameters\r\n*/\r\nexport function SetSignalClose(event, eventRaisingElement, shadowRoot, instance, parameters) {\r\n     window.IOB.setState(instance.relativesignalpath + instance.valveid + \"CIN\",true);\r\n}\r\n\r\n/**\r\n* SetSignalStop - 'click' event of <button>\r\n* @param {PointerEvent} event\r\n* @param {Element} eventRaisingElement\r\n* @param {ShadowRoot} shadowRoot\r\n* @param {BaseScreenViewerAndControl} instance\r\n* @param {Object.<string, *>} parameters\r\n*/\r\nexport function SetSignalStop(event, eventRaisingElement, shadowRoot, instance, parameters) {\r\n    //window.IOB.setState(\"my-opcua.0.ns=2___s=Rslinx_For_IO___Device1___Pipeline___Online___ES\"+instance.valveid+\"S\",1);\r\n}","properties":{"oIN":{"type":"signal"},"cIN":{"type":"signal"},"opened":{"type":"boolean"},"closed":{"type":"boolean"},"valveid":{"type":"string"},"relativesignalpath":{"type":"string"}},"settings":{"visibilityEnabled":"false","visibilityGroups":"","visibilityAction":"hide","visibilityRedirectScreen":""}}