{
  "properties": {
    "request": {
      "type": "string",
      "default": ""
    }
  },
  "settings": {
    "width": "380px",
    "height": "320px"
  },
  "html": "<div id=\"dlgRoot\"></div>",
  "style": ":host{display:block;width:min(380px,calc(100vw - 32px))}\n*{box-sizing:border-box}\n.dlg{background:var(--ui-surface-2,#121a27);color:var(--ui-text,#e4eaf3);border:1px solid var(--ui-border,#2c3a52);border-radius:14px;box-shadow:0 20px 50px rgba(0,0,0,.45);overflow:hidden;font:14px/1.45 'IBM Plex Sans','Segoe UI',system-ui,sans-serif}\n.sev-danger{border-top:3px solid var(--ui-error,#ff4d6d)} .sev-warning{border-top:3px solid var(--ui-warn,#f0a020)} .sev-info{border-top:3px solid var(--ui-accent,var(--ui-info,#2680eb))}\n.hd{display:flex;gap:12px;align-items:flex-start;padding:16px 16px 10px}\n.ico{flex:none;width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font:700 16px 'IBM Plex Mono',ui-monospace,monospace}\n.sev-info .ico{background:color-mix(in srgb,var(--ui-accent,var(--ui-info,#2680eb)) 18%,transparent);color:var(--ui-accent,var(--ui-info,#2680eb))}\n.sev-warning .ico{background:color-mix(in srgb,var(--ui-warn,#f0a020) 18%,transparent);color:var(--ui-warn,#f0a020)}\n.sev-danger .ico{background:color-mix(in srgb,var(--ui-error,#ff4d6d) 18%,transparent);color:var(--ui-error,#ff4d6d)}\n.t{font-weight:600;font-size:15px;line-height:1.3}\n.s{font-size:12.5px;color:var(--ui-dim,#8794a9);margin-top:2px}\n.bd{padding:4px 16px 14px;display:flex;flex-direction:column;gap:10px}\n.chg{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;background:var(--ui-surface,#18222f);border:1px solid var(--ui-border,#2c3a52);border-radius:10px;padding:10px 12px}\n.v{font:600 15px 'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}\n.l{font-size:11px;color:var(--ui-dim,#8794a9)} .to{text-align:right} .arr{color:var(--ui-dim,#8794a9)}\n.meta{font:12px 'IBM Plex Mono',ui-monospace,monospace;color:var(--ui-dim,#8794a9);overflow-wrap:anywhere}\n.fld{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ui-dim,#8794a9)}\n.fld input,.fld textarea{font:14px 'IBM Plex Sans','Segoe UI',system-ui,sans-serif;background:var(--ui-input,var(--ui-surface,#18222f));color:var(--ui-text,#e4eaf3);border:1px solid var(--ui-border,#2c3a52);border-radius:8px;padding:8px 10px;resize:none}\n.fld input[readonly]{color:var(--ui-dim,#8794a9)}\n.err{font-size:12.5px;color:var(--ui-error,#ff4d6d)}\n.busy{font-size:12.5px;color:var(--ui-dim,#8794a9)}\n.choice{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.ft{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;align-items:center;padding:12px 16px;border-top:1px solid var(--ui-border,#2c3a52)}\n.timer{font:11.5px 'IBM Plex Mono',ui-monospace,monospace;color:var(--ui-dim,#8794a9);margin-right:auto}\nbutton{font:600 13px 'IBM Plex Sans','Segoe UI',system-ui,sans-serif;border-radius:8px;padding:8px 14px;cursor:pointer;border:1px solid var(--ui-border,#2c3a52);background:transparent;color:var(--ui-text,#e4eaf3)}\n.choice button{padding:12px 10px}\nbutton.cur{border-color:var(--ui-accent,var(--ui-info,#2680eb));box-shadow:inset 0 0 0 1px var(--ui-accent,var(--ui-info,#2680eb))}\nbutton:disabled{opacity:.55;cursor:default}\n.pri{background:var(--ui-accent,var(--ui-info,#2680eb));border-color:var(--ui-accent,var(--ui-info,#2680eb));color:#fff}\n.dng{background:var(--ui-error,#ff4d6d);border-color:var(--ui-error,#ff4d6d);color:#fff}\nbutton:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--ui-accent,var(--ui-info,#2680eb));outline-offset:2px}",
  "script": "// Confirm & Protect dialog (docs/confirm-protect.md). The runtime sets `request` (JSON):\n//   { mode: confirm|choice|password|supervisor, severity: info|warning|danger, title, message,\n//     showChange, oldText, newText, stateId, buttons:[{label, role, value, current}], username,\n//     reason: off|optional|required, timeout, busy, error, labels:{…translated texts} }\n// and waits for the event `dialog-result` with { role: confirm|reject|value, value?, password?,\n// reason?, supervisor?:{username,password} }. Colours come only from the --ui-* theme tokens.\n// Copy this control into the project to change its look; keep the request / dialog-result contract.\nconst SAMPLE = { mode: 'confirm', severity: 'warning', title: 'V-101 klapanı açılsın?', message: 'Xətt 2 · Qazan girişi', showChange: true,\n    oldText: 'Bağlı', newText: 'Açıq', stateId: 'modbus.0.coils.V101_cmd', buttons: [], timeout: 0,\n    labels: { yes: 'Bəli', no: 'Xeyr', cancel: 'Ləğv et', confirm: 'Təsdiqlə və yaz', current: 'indiki', new: 'yeni', user: 'İstifadəçi', password: 'Parol',\n        reason: 'Səbəb', reasonOptional: 'Səbəb', checking: '…', supervisorTitle: 'Supervisor', supervisorHint: '', supervisorUser: 'Supervisor',\n        supervisorPassword: 'Parol', approve: 'Təsdiqlə', secondsLeft: '{n} s' } };\n\nexport function init(instance) {\n    let remain = 0, tick = 0;\n    const mk = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = String(text); return n; };\n    const send = (detail) => {\n        // the password leaves the input at once\n        for (const i of instance.shadowRoot.querySelectorAll('input[type=password]')) i.value = '';\n        instance.dispatchEvent(new CustomEvent('dialog-result', { detail, bubbles: true, composed: true }));\n    };\n    const render = () => {\n        const root = instance._getDomElement('dlgRoot');\n        if (!root) return;\n        let r;\n        try { r = instance.request ? JSON.parse(instance.request) : SAMPLE; } catch (e) { r = SAMPLE; }\n        const L = r.labels || {};\n        root.textContent = '';\n        const d = mk('div', 'dlg sev-' + (r.severity || 'warning'));\n        d.setAttribute('role', 'dialog'); d.setAttribute('aria-modal', 'true');\n        const hd = mk('div', 'hd');\n        const ico = mk('div', 'ico', r.mode === 'password' || r.mode === 'supervisor' ? '\\u{1F512}' : r.mode === 'choice' ? '⇄' : '!');\n        const tt = mk('div'); tt.append(mk('div', 't', r.mode === 'supervisor' ? L.supervisorTitle : r.title), mk('div', 's', r.message || ''));\n        hd.append(ico, tt); d.append(hd);\n        const bd = mk('div', 'bd'); d.append(bd);\n        if (r.showChange) {\n            const c = mk('div', 'chg');\n            const a = mk('div'); a.append(mk('div', 'l', L.current), mk('div', 'v', r.oldText));\n            const b = mk('div', 'to'); b.append(mk('div', 'l', L.new), mk('div', 'v', r.newText));\n            c.append(a, mk('div', 'arr', '→'), b); bd.append(c);\n        }\n        if (r.stateId) bd.append(mk('div', 'meta', r.stateId));\n        const inputs = {};\n        const field = (key, label, type, value, ro) => {\n            const f = mk('label', 'fld'); f.append(mk('span', '', label));\n            const i = document.createElement(type === 'area' ? 'textarea' : 'input');\n            if (type !== 'area') i.type = type; else i.rows = 2;\n            i.value = value || ''; if (ro) i.readOnly = true; i.autocomplete = 'off';\n            f.append(i); bd.append(f); inputs[key] = i; return i;\n        };\n        if (r.mode === 'choice') {\n            const g = mk('div', 'choice');\n            for (const b of (r.buttons || []).filter(x => x.role !== 'reject')) {\n                const x = mk('button', b.current ? 'cur' : '', b.label); x.type = 'button'; x.disabled = !!b.current || !!r.busy;\n                x.onclick = () => send({ role: b.role || 'value', value: b.value });\n                g.append(x);\n            }\n            bd.append(g);\n        }\n        if (r.mode === 'password') {\n            field('user', L.user, 'text', r.username, true);\n            field('password', L.password, 'password', '');\n        }\n        if (r.mode === 'supervisor') {\n            if (L.supervisorHint) bd.append(mk('div', 's', L.supervisorHint));\n            field('supUser', L.supervisorUser, 'text', '');\n            field('supPassword', L.supervisorPassword, 'password', '');\n        }\n        if ((r.mode === 'password' || r.mode === 'supervisor') && r.reason && r.reason !== 'off')\n            field('reason', r.reason === 'required' ? L.reason : L.reasonOptional, 'area', '');\n        if (r.error) bd.append(mk('div', 'err', '✕ ' + r.error));\n        if (r.busy) bd.append(mk('div', 'busy', L.checking));\n        const ft = mk('div', 'ft');\n        const timer = mk('span', 'timer', ''); ft.append(timer);\n        const no = mk('button', '', r.mode === 'confirm' ? L.no : L.cancel); no.type = 'button'; no.disabled = !!r.busy;\n        no.onclick = () => send({ role: 'reject' });\n        ft.append(no);\n        let yes = null;\n        if (r.mode !== 'choice') {\n            yes = mk('button', r.severity === 'danger' ? 'dng' : 'pri', r.mode === 'supervisor' ? L.approve : r.mode === 'password' ? L.confirm : L.yes);\n            yes.type = 'button'; yes.disabled = !!r.busy;\n            yes.onclick = () => send(r.mode === 'supervisor'\n                ? { role: 'confirm', supervisor: { username: inputs.supUser.value, password: inputs.supPassword.value }, reason: inputs.reason ? inputs.reason.value : '' }\n                : { role: 'confirm', password: inputs.password ? inputs.password.value : undefined, reason: inputs.reason ? inputs.reason.value : '' });\n            ft.append(yes);\n            for (const i of Object.values(inputs)) if (i.localName === 'input') i.addEventListener('keydown', ev => { if (ev.key === 'Enter') yes.click(); });\n        }\n        d.append(ft); root.append(d);\n        setTimeout(() => { const f = inputs.password || inputs.supUser || yes; if (f && !r.busy) f.focus(); }, 0);\n        clearInterval(tick);\n        if (r.timeout && !r.busy && instance.request) {\n            if (!remain) remain = r.timeout;\n            const show = () => { timer.textContent = (L.secondsLeft || '{n} s').replace('{n}', remain); };\n            show();\n            tick = setInterval(() => { remain = Math.max(0, remain - 1); show(); }, 1000);\n        }\n    };\n    instance._assignEvent('request-changed', render);\n    render();\n}\n"
}