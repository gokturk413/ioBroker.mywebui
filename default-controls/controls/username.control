{"html":"<label id=\"goattextloggedusername\" style=\"position:absolute;left:16px;top:22px;width:100%;height:100%;\"></label>\n","style":":host {\nbackground: transparent;\n}\n\n* {\n    box-sizing: border-box;\n}","script":"export async function init(instance)\r\n{\r\n    window.IOB.connection._socket.emit('authEnabled', function (isAuthenticationUsed, userName) {\r\n    window.IOB.setState('local_username',userName,true);\r\n    instance._getDomElement(\"goattextloggedusername\").textContent = userName;\r\n    });\r\n    window.IOB.setState('local_alarmvisibility', 0, true);\r\n}","settings":{"width":"100%","height":"100%","visibilityEnabled":"false","visibilityGroups":"","visibilityAction":"hide","visibilityRedirectScreen":""}}