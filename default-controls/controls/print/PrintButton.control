{"html":"<button id=\"printbtn1\" class=\"print-button dispnone\" onclick=\"window.print()\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-printer\" viewBox=\"0 0 16 16\">\n        <path d=\"M2 7a1 1 0 0 0-1 1v3a2 2 0 0 0 2 2h1v1.5a1.5 1.5 0 0 0 3 0V13h2v1.5a1.5 1.5 0 0 0 3 0V13h1a2 2 0 0 0 2-2V8a1 1 0 0 0-1-1H2z\"></path>\n        <path fill-rule=\"evenodd\" d=\"M5 1a2 2 0 0 0-2 2v3h10V3a2 2 0 0 0-2-2H5zm7 5H4V3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3z\"></path>\n    </svg>\nPrint\n</button>\n","style":":host {\n    background: transparent;\n}\n\n* {\n    box-sizing: border-box;\n}\n\n.print-button {\n    background-color: #2698b5; /* Green background */\n    border: none; /* Remove borders */\n    color: white; /* White text */\n    padding: 12px 24px; /* Some padding */\n    font-size: 16px; /* Set a font size */\n    cursor: pointer; /* Mouse pointer on hover */\n    display: flex; /* Flexbox layout */\n    align-items: center; /* Center items vertically */\n}\n\n\n\n.print-button svg {\n    margin-right: 8px; /* Space between icon and text */\n    fill: white; /* Icon color */\n}\n\n.print-button:hover {\n    background-color: #45a049; /* Darker green background on hover */\n}\n\n","settings":{"visibilityEnabled":"false","visibilityGroups":"","visibilityAction":"hide","visibilityRedirectScreen":""}}