{"html":"<div class=\"svg-container\">\n    <img id=\"svgImg\" src=\"\" bind-css:width=\"??width\" bind-css:height=\"??height\" bind-css:border-color=\"??borderColor\" />\n</div>","style":":host {\n    display: inline-block;\n    width: 100%;\n    height: 100%;\n    background-color: transparent;\n}\n\n* {\n    box-sizing: border-box;\n}\n\n.svg-container {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.svg-container img {\n    max-width: 100%;\n    max-height: 100%;\n    object-fit: contain;\n    border-style: solid;\n    border-width: 1px;\n}","script":"/**\n * @param {BaseScreenViewerAndControl} instance\n */\nexport function init(instance) {\n    updateSvg(instance);\n    instance._assignEvent('svgContent-changed', () => updateSvg(instance));\n}\n\nexport function connectedCallback(instance) {\n    updateSvg(instance);\n}\n\nexport function disconnectedCallback(instance) {\n}\n\n/**\n * @param {BaseScreenViewerAndControl} instance\n */\nfunction updateSvg(instance) {\n    const img = instance._getDomElement('svgImg');\n    if (!img) return;\n\n    const rawSvg = instance.svgContent || '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 259\"><path d=\"M44.1303,162.296 44.1303,133.587 72.6946,162.296 z\" style=\"fill:#0000ff;stroke:#0000ff;\" /></svg>';\n\n    try {\n        const b64 = btoa(unescape(encodeURIComponent(rawSvg)));\n        img.src = `data:image/svg+xml;base64,${b64}`;\n    } catch (e) {\n        console.warn('SVG Base64 encoding error:', e);\n    }\n}","properties":{"svgContent":{"type":"string","default":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 259\"><path d=\"M44.1303,162.296 44.1303,133.587 72.6946,162.296 z\" style=\"fill:#0000ff;stroke:#0000ff;\" /></svg>"},"width":{"type":"string","default":"500px"},"height":{"type":"string","default":"200px"},"borderColor":{"type":"color","default":"#cccccc"}},"settings":{}}
