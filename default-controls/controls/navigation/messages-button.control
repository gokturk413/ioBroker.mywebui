{"properties":{"label":{"type":"string","default":""}},"settings":{"width":"40px","height":"40px"},"html":"<button id=\"btn\" class=\"mb\" type=\"button\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h16v11H9l-5 4z\"/><path d=\"M8 9h8M8 12h5\"/></svg><span id=\"lbl\" class=\"mb-lbl\"></span><span id=\"badge\" class=\"mb-badge\" hidden></span></button>","style":":host{display:inline-block;}\n.mb{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:40px;height:40px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--ui-text,#e2e6ec);cursor:pointer;font:13px 'Segoe UI',Roboto,sans-serif;}\n.mb:hover{background:color-mix(in srgb,var(--ui-text,#fff) 10%,transparent);}\n.mb:focus-visible{outline:2px solid var(--ui-accent,#6ea2ff);outline-offset:1px;}\n.mb-lbl:empty{display:none;}\n.mb-badge{position:absolute;top:3px;right:3px;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:var(--ui-error,#ff5c61);color:#fff;font:700 10px/16px 'Segoe UI',sans-serif;text-align:center;}\n.mb-badge[hidden]{display:none;}\n@media (pointer: coarse){.mb{min-width:44px;height:44px;}}","script":"// Messages (common/MessagesPanel.js): opens the live traffic panel. The badge counts commands the\n// driver did not confirm since the panel was last opened. Hidden for users who may not see Messages.\nfunction render(instance) {\n    const btn = instance._getDomElement('btn'), lbl = instance._getDomElement('lbl'), badge = instance._getDomElement('badge');\n    if (!btn) return;\n    const iob = window.IOB;\n    instance.style.display = iob?.messagesAllowed ? '' : 'none';\n    if (lbl) lbl.textContent = instance.label || '';\n    btn.title = instance.label || 'Messages';\n    const n = iob?.messages?.unseen || 0;\n    if (badge) { badge.textContent = n > 99 ? '99+' : String(n); badge.hidden = !n; }\n}\nexport function init(instance) {\n    render(instance);\n    instance._assignEvent('label-changed', () => render(instance));\n    instance._getDomElement('btn')?.addEventListener('click', () => { window.IOB?.toggleMessages?.(); render(instance); });\n}\nexport function connectedCallback(instance) {\n    // new messages, and the right to see them (decided by the server after the page loads)\n    instance._msgOff = window.IOB?.messages?.on?.(() => render(instance));\n    instance._msgTimer = setInterval(() => render(instance), 3000);\n    render(instance);\n}\nexport function disconnectedCallback(instance) {\n    instance._msgOff?.(); instance._msgOff = null;\n    clearInterval(instance._msgTimer);\n}\n"}