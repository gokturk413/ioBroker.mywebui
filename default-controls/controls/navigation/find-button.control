{"properties":{"label":{"type":"string","default":""},"query":{"type":"string","default":""}},"settings":{"width":"40px","height":"40px"},"html":"<button id=\"btn\" class=\"fb\" type=\"button\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"M15.5 15.5L21 21\"/></svg><span id=\"lbl\" class=\"fb-lbl\"></span></button>","style":":host{display:inline-block;}\n.fb{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:40px;height:40px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--ui-text,#e2e6ec);cursor:pointer;font:13px 'Segoe UI',Roboto,sans-serif;}\n.fb:hover{background:color-mix(in srgb,var(--ui-text,#fff) 10%,transparent);}\n.fb:focus-visible{outline:2px solid var(--ui-accent,#6ea2ff);outline-offset:1px;}\n.fb-lbl:empty{display:none;}\n@media (pointer: coarse){.fb{min-width:44px;height:44px;}}","script":"// Find (common/FindPanel.js): opens the panel; Ctrl+Shift+F does the same on a keyboard.\nfunction render(instance) {\n    const lbl = instance._getDomElement('lbl');\n    if (lbl) lbl.textContent = instance.label || '';\n    const btn = instance._getDomElement('btn');\n    if (btn) btn.title = instance.label || 'Find';\n}\nexport function init(instance) {\n    render(instance);\n    instance._assignEvent('label-changed', () => render(instance));\n    instance._getDomElement('btn')?.addEventListener('click', () => window.IOB?.openFind?.(instance.query || ''));\n}\n"}