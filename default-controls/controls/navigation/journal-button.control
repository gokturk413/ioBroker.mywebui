{"properties":{"label":{"type":"string","default":""}},"settings":{"width":"40px","height":"40px"},"html":"<button id=\"btn\" class=\"mb\" type=\"button\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4h11l3 3v13H5z\"/><path d=\"M8 9h8M8 13h8M8 17h5\"/></svg><span id=\"lbl\" class=\"mb-lbl\"></span></button>","style":":host{display:inline-block;}\n.mb{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:40px;height:40px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--ui-text,#e2e6ec);cursor:pointer;font:13px 'Segoe UI',Roboto,sans-serif;}\n.mb:hover{background:color-mix(in srgb,var(--ui-text,#fff) 10%,transparent);}\n.mb:focus-visible{outline:2px solid var(--ui-accent,#6ea2ff);outline-offset:1px;}\n.mb-lbl:empty{display:none;}\n@media (pointer: coarse){.mb{min-width:44px;height:44px;}}","script":"// Journal (common/JournalPanel.js): the history the server lets this user see — commands with who,\n// where and the driver's answer, values, driver events, logs, clients. What it shows is decided per\n// user on the server (Settings → Journal → who may see what).\nfunction render(instance) {\n    const lbl = instance._getDomElement('lbl'), btn = instance._getDomElement('btn');\n    if (lbl) lbl.textContent = instance.label || '';\n    if (btn) btn.title = instance.label || 'Journal';\n}\nexport function init(instance) {\n    render(instance);\n    instance._assignEvent('label-changed', () => render(instance));\n    instance._getDomElement('btn')?.addEventListener('click', () => window.IOB?.toggleJournal?.());\n}\n"}