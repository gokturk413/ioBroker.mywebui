{"properties":{},"settings":{"width":"220px","height":"100%"},"html":"<div id=\"sb\" class=\"sb\"><div id=\"sbHdr\" class=\"sb-hdr\"></div><div id=\"slotTop\" class=\"sb-slot\"></div><div id=\"sbItems\" class=\"sb-items\"></div><div id=\"slotBottom\" class=\"sb-slot\"></div></div>","style":":host{display:block;width:100%;height:100%;box-sizing:border-box;}\r\n.sb{display:flex;flex-direction:column;height:100%;width:100%;background:var(--sb-bg,linear-gradient(180deg,#1e3c72 0%,#2a5298 100%));color:var(--sb-fg,rgba(255,255,255,.9));box-shadow:2px 0 18px rgba(0,0,0,.28);-webkit-backdrop-filter:var(--ui-backdrop,none);backdrop-filter:var(--ui-backdrop,none);box-sizing:border-box;}\r\n.sb-hdr{padding:18px 16px 14px;font-weight:700;font-size:16px;letter-spacing:.5px;color:var(--sb-hdr-fg,#fff);border-bottom:1px solid rgba(255,255,255,.12);white-space:nowrap;overflow:hidden;}\r\n.sb-items{flex:1;overflow-y:auto;overflow-x:hidden;padding:8px 0;}\r\n.sb-items::-webkit-scrollbar{width:6px;}\r\n.sb-items::-webkit-scrollbar-thumb{background:rgba(255,255,255,.3);border-radius:3px;}\r\n.sb-slot{display:block;}\r\n:host([data-theme=\"dark\"]){--sb-bg:linear-gradient(180deg,#0a0e27 0%,#1a1f3a 100%);--sb-fg:rgba(255,255,255,.88);--sb-hdr-fg:#fff;--mi-bg:rgba(255,255,255,.04);--mi-hover:rgba(255,255,255,.1);--mi-active:linear-gradient(135deg,rgba(74,158,255,.35),rgba(74,158,255,.14));--mi-active-fg:#fff;--mi-active-icon:#4a9eff;}\r\n:host([data-theme=\"light\"]){--sb-bg:linear-gradient(180deg,#f5f7fa 0%,#e4e8f0 100%);--sb-fg:#37474f;--sb-hdr-fg:#1a237e;--mi-bg:rgba(0,0,0,.04);--mi-hover:rgba(33,150,243,.1);--mi-active:linear-gradient(135deg,rgba(33,150,243,.22),rgba(33,150,243,.1));--mi-active-fg:#1565c0;--mi-active-icon:#1976d2;}\r\n:host([data-theme=\"purple\"]){--sb-bg:linear-gradient(180deg,#4a1d6e 0%,#7b2d8e 100%);--sb-fg:rgba(255,255,255,.9);--sb-hdr-fg:#fff;--mi-bg:rgba(255,255,255,.07);--mi-hover:rgba(255,255,255,.16);--mi-active:linear-gradient(135deg,rgba(224,64,251,.35),rgba(224,64,251,.15));--mi-active-fg:#fff;--mi-active-icon:#8e24aa;}\r\n:host([data-theme=\"green\"]){--sb-bg:linear-gradient(180deg,#1b5e20 0%,#2e7d32 100%);--sb-fg:rgba(255,255,255,.9);--sb-hdr-fg:#fff;--mi-bg:rgba(255,255,255,.07);--mi-hover:rgba(255,255,255,.16);--mi-active:linear-gradient(135deg,rgba(105,240,174,.3),rgba(105,240,174,.12));--mi-active-fg:#fff;--mi-active-icon:#2e7d32;}\r\n:host([data-theme=\"orange\"]){--sb-bg:linear-gradient(180deg,#bf360c 0%,#e64a19 100%);--sb-fg:rgba(255,255,255,.92);--sb-hdr-fg:#fff;--mi-bg:rgba(255,255,255,.08);--mi-hover:rgba(255,255,255,.18);--mi-active:linear-gradient(135deg,rgba(255,171,64,.32),rgba(255,171,64,.14));--mi-active-fg:#fff;--mi-active-icon:#e64a19;}\r\n:host([data-theme=\"teal\"]){--sb-bg:linear-gradient(180deg,#004d40 0%,#00695c 100%);--sb-fg:rgba(255,255,255,.9);--sb-hdr-fg:#fff;--mi-bg:rgba(255,255,255,.07);--mi-hover:rgba(255,255,255,.16);--mi-active:linear-gradient(135deg,rgba(29,233,182,.3),rgba(29,233,182,.12));--mi-active-fg:#fff;--mi-active-icon:#00897b;}\r\n:host([data-theme=\"auto\"]){--sb-bg:var(--ui-surface,#252b38);--sb-fg:var(--ui-text,#e2e6ec);--sb-hdr-fg:var(--ui-text,#fff);--mi-bg:color-mix(in srgb,var(--ui-text,#fff) 6%,transparent);--mi-fg:var(--ui-text,#e2e6ec);--mi-hover:color-mix(in srgb,var(--ui-text,#fff) 13%,transparent);--mi-active:color-mix(in srgb,var(--accent,#2680eb) 26%,transparent);--mi-active-border:color-mix(in srgb,var(--accent,#2680eb) 55%,transparent);--mi-active-fg:var(--ui-text,#fff);--mi-active-icon:var(--accent,#2680eb);}\r\n:host([data-orient=\"h\"]) .sb{flex-direction:row;align-items:center;box-shadow:0 2px 18px rgba(0,0,0,.28);}\r\n:host([data-orient=\"h\"]) .sb-hdr{border-bottom:0;border-right:1px solid rgba(255,255,255,.12);padding:0 16px;align-self:stretch;display:flex;align-items:center;}\r\n:host([data-orient=\"h\"]) .sb-items{display:flex;flex-direction:row;align-items:center;overflow-x:auto;overflow-y:hidden;padding:0 6px;height:100%;}\r\n:host([data-orient=\"h\"]) .sb-items::-webkit-scrollbar{height:4px;width:auto;}\r\n:host([data-orient=\"h\"]) .sb-slot{display:flex;align-items:center;gap:6px;}\r\n","script":"export function init(instance){\r\n    instance._bindingsRefresh?.();\r\n    const IOB = window.IOB;\r\n    const cfg = (IOB && IOB.config && IOB.config.navigation) || {};\r\n    instance.setAttribute('data-theme', cfg.theme || 'default');\r\n    function htmlFromDef(def){\r\n        let attrs='';\r\n        if(def.defaultAttributes) for(const a in def.defaultAttributes){ const v=def.defaultAttributes[a]; attrs+=' '+a+'=\"'+String(typeof v==='object'?JSON.stringify(v):v).replace(/\"/g,'&quot;')+'\"'; }\r\n        let style='';\r\n        if(def.defaultStyles) for(const k in def.defaultStyles) style+=k+':'+def.defaultStyles[k]+';';\r\n        if(def.defaultWidth) style+='width:'+def.defaultWidth+';';\r\n        if(def.defaultHeight) style+='height:'+def.defaultHeight+';';\r\n        return '<'+def.tag+attrs+(style?' style=\"'+style+'\"':'')+'>'+(def.defaultContent||'')+'</'+def.tag+'>';\r\n    }\r\n    function wireSlot(zone, cfgRoot, key){\r\n        if(!zone) return;\r\n        zone.innerHTML = (cfgRoot && cfgRoot.slots && cfgRoot.slots[key]) || '';\r\n        if(!isDesigner) return;\r\n        if(!zone.innerHTML.trim()){ zone.dataset.empty='1'; zone.style.minHeight='30px'; zone.style.outline='1px dashed rgba(255,255,255,.28)'; zone.style.borderRadius='8px'; zone.style.margin='4px 8px'; }\r\n        (function(){\r\n            let chip=null,target=null,hideT=null;\r\n            const saveFromDom=()=>{ if(!cfgRoot.slots) cfgRoot.slots={}; cfgRoot.slots[key]=Array.from(zone.children).map(c=>c.outerHTML).join(''); if(window.IOB&&window.IOB.saveConfig) window.IOB.saveConfig(); };\r\n            const hideChip=()=>{ if(chip) chip.style.display='none'; target=null; };\r\n            const ensureChip=()=>{ if(chip) return chip; chip=document.createElement('div'); chip.className='nav-slot-delchip'; chip.textContent='✕'; chip.title='Delete'; chip.style.cssText='position:fixed;z-index:2147483647;width:18px;height:18px;line-height:18px;text-align:center;font:700 12px/18px sans-serif;background:#e74c3c;color:#fff;border-radius:50%;cursor:pointer;box-shadow:0 1px 5px rgba(0,0,0,.45);user-select:none;display:none;'; chip.addEventListener('mouseenter',()=>{ if(hideT){clearTimeout(hideT);hideT=null;} }); chip.addEventListener('mouseleave',hideChip); chip.addEventListener('click',e=>{ e.preventDefault(); e.stopPropagation(); if(target&&target.parentNode===zone){ target.remove(); saveFromDom(); } hideChip(); }); document.body.appendChild(chip); return chip; };\r\n            const showChip=(el)=>{ if(hideT){clearTimeout(hideT);hideT=null;} target=el; const c=ensureChip(); const r=el.getBoundingClientRect(); c.style.left=(r.right-9)+'px'; c.style.top=(r.top-9)+'px'; c.style.display='block'; };\r\n            zone.addEventListener('mouseover', e=>{ let el=e.target; while(el && el!==zone && el.parentNode!==zone) el=el.parentNode; if(el && el.parentNode===zone && el.nodeType===1) showChip(el); });\r\n            zone.addEventListener('mouseleave', ()=>{ hideT=setTimeout(()=>{ if(chip && chip.style.display!=='none' && !chip.matches(':hover')) hideChip(); }, 160); });\r\n        })();\r\n        zone.addEventListener('dragover', e=>{ if(e.dataTransfer && e.dataTransfer.types && e.dataTransfer.types.indexOf('text/json/elementdefintion')>=0){ e.preventDefault(); zone.style.background='rgba(255,255,255,.18)'; } });\r\n        zone.addEventListener('dragleave', ()=>{ zone.style.background=''; });\r\n        zone.addEventListener('drop', e=>{ e.preventDefault(); e.stopPropagation(); zone.style.background='';\r\n            try{ const td=e.dataTransfer.getData('text/json/elementdefintion'); if(!td) return; const def=JSON.parse(td); const html=htmlFromDef(def);\r\n                if(!cfgRoot.slots) cfgRoot.slots={}; cfgRoot.slots[key]=(cfgRoot.slots[key]||'')+html;\r\n                if(window.IOB && window.IOB.saveConfig) window.IOB.saveConfig();\r\n            }catch(err){ console.warn('[nav] slot drop failed', err); }\r\n        });\r\n    }\r\n    const isDesigner = !!document.querySelector('iobroker-webui-app-shell');\r\n    if(typeof isDesigner!=='undefined' && isDesigner){ try{ document.querySelectorAll('.nav-slot-delchip').forEach(n=>n.remove()); }catch(e){} }\r\n    const hdr=instance._getDomElement('sbHdr'), items=instance._getDomElement('sbItems');\r\n    if(cfg.bgColor) instance.style.setProperty('--sb-bg', cfg.bgColor);\r\n    if(cfg.textColor){ instance.style.setProperty('--sb-fg', cfg.textColor); instance.style.setProperty('--mi-fg', cfg.textColor); }\r\n    if(cfg.menuHeaderTextColor) instance.style.setProperty('--sb-hdr-fg', cfg.menuHeaderTextColor);\r\n    if(cfg.bgColorSelected){ instance.style.setProperty('--mi-active', cfg.bgColorSelected); instance.style.setProperty('--mi-active-icon', cfg.bgColorSelected); }\r\n    if(cfg.textColorSelected) instance.style.setProperty('--mi-active-fg', cfg.textColorSelected);\r\n    if(hdr){ hdr.textContent=cfg.menuHeaderText||''; hdr.style.display=cfg.menuHeaderText?'':'none'; }\r\n    // how the menu opens: full, icons only, hidden, or as this browser left it last time\r\n    const stateKey='webui.nav.state.'+((IOB&&IOB.configPath)||'');\r\n    const startAs=['expanded','icons','hidden','last'].includes(cfg.startState)?cfg.startState:'expanded';\r\n    let state=startAs;\r\n    if(startAs==='last'){ try{ state=localStorage.getItem(stateKey)||'expanded'; }catch(e){ state='expanded'; } }\r\n    if(!['expanded','icons','hidden'].includes(state)) state='expanded';\r\n    if(state==='hidden'&&cfg.doNotHideCompletely) state='icons';\r\n    const ICONS_W=64; let burger=null; let hasItems=false;\r\n    const navWidth = cfg.menuWidth ? (/^\\d+$/.test(String(cfg.menuWidth))?cfg.menuWidth+'px':String(cfg.menuWidth)) : '220px';\r\n    // Groups: none (a flat list), 'folder' (the screen's folder: tests/pump → tests) or 'group'\r\n    // (the screen's own Navigation → Group). A group opens and closes; a \"/\" nests it.\r\n    const groupBy = cfg.groupBy || 'none';\r\n    const groupsKey='webui.nav.groups.'+((IOB&&IOB.configPath)||'');\r\n    let openGroups={}; try{ openGroups=JSON.parse(localStorage.getItem(groupsKey)||'{}')||{}; }catch(e){}\r\n    const saveGroups=()=>{ try{ localStorage.setItem(groupsKey, JSON.stringify(openGroups)); }catch(e){} };\r\n    const groupOf=(e)=> groupBy==='folder' ? (e.name.includes('/') ? e.name.slice(0, e.name.lastIndexOf('/')) : '') : groupBy==='group' ? String(e.group||'').replace(/^\\/+|\\/+$/g,'') : '';\r\n    const setActive=(name)=>{\r\n        if(!items) return;\r\n        items.querySelectorAll('webui-navigation-menu-item').forEach(mi=>{ if(mi.kind!=='group') mi.selected=(mi.screenName===name); });\r\n        // the group holding the open screen is opened\r\n        const own=items.querySelector('webui-navigation-menu-item[data-entry=\"'+CSS.escape(String(name))+'\"]');\r\n        for(let g=own&&own.parentElement; g&&g!==items; g=g.parentElement){ if(g.dataset.group!=null && g.hidden){ g.hidden=false; const head=g.previousElementSibling; if(head) head.expanded=true; } }\r\n    };\r\n    const navTo=(name,kind)=>{ if(IOB&&IOB.changeView) IOB.changeView.emit(kind==='report'?{name:name,type:'report'}:name); setActive(name); if(cfg.hideAfterSelection) setState('hidden'); };\r\n    async function loadEntries(){\r\n        if(!IOB||!IOB.getAllNames) return [];\r\n        // Reports carry every screen setting, navigation among them, so they belong in the\r\n        // menu exactly as screens do — the entry remembers which kind it is so the runtime opens\r\n        // a .report in the report viewer rather than looking for a screen of that name.\r\n        // Screens and reports are listed at the same time and every file is read at the same\r\n        // time — each listing is a round trip to the server, so waiting for one before the next\r\n        // is what made the menu slow.\r\n        const kinds=await Promise.all(['screen','report'].map(async k=>[k,await IOB.getAllNames(k).catch(()=>[])]));\r\n        const all=await Promise.all(kinds.flatMap(([kind,names])=>names.map(async n=>{ const o=await IOB.getWebuiObject(kind,n).catch(()=>null); const nv=o&&o.settings&&o.settings.navigation; return nv&&nv.show?{name:n,kind:kind,title:nv.title||n,order:parseFloat(nv.order)||0,image:nv.image||'',group:nv.group||'',badge:nv.badge||''}:null; })));\r\n        const list=all.filter(Boolean);\r\n        list.sort((a,b)=>a.order-b.order); return list;\r\n    }\r\n    // The menu this browser saw last is drawn at once; the fresh list replaces it when it differs.\r\n    const menuCacheKey='webui.nav.menu.'+((IOB&&IOB.configPath)||'');\r\n    async function render(){\r\n        // items made before the menu item is defined lose what is set on them (level, image):\r\n        // wait for the definition, at most 3 s\r\n        if(window.customElements&&!customElements.get('webui-navigation-menu-item')) await Promise.race([customElements.whenDefined('webui-navigation-menu-item'), new Promise(r=>setTimeout(r,3000))]);\r\n        let cached=null;\r\n        if(!isDesigner){ try{ cached=JSON.parse(localStorage.getItem(menuCacheKey)||'null'); }catch(e){} if(Array.isArray(cached)) draw(cached); }\r\n        const list=await loadEntries();\r\n        const fresh=JSON.stringify(list);\r\n        if(!Array.isArray(cached)||JSON.stringify(cached)!==fresh) draw(list);\r\n        if(!isDesigner){ try{ localStorage.setItem(menuCacheKey,fresh); }catch(e){} }\r\n    }\r\n    function itemFor(e, level){\r\n        const mi=document.createElement('webui-navigation-menu-item');\r\n        mi.dataset.managed='1'; mi.dataset.entry=e.name;\r\n        // inside its folder an entry without its own title shows its name without the folder\r\n        mi.screenName=e.name; mi.title=(groupBy==='folder'&&e.title===e.name&&e.name.includes('/'))?e.name.slice(e.name.lastIndexOf('/')+1):e.title; mi.image=e.image; mi.level=level; mi.tint=cfg.tintIcons!==false; mi.compact=(state==='icons');\r\n        mi.badge=badgeVals.has(e.name)?badgeVals.get(e.name):'';\r\n        mi.addEventListener('menuitemclick',()=>navTo(e.name,e.kind));\r\n        return mi;\r\n    }\r\n    // entries → a tree of groups; a group sits where its first entry (by order) sits\r\n    function tree(list){\r\n        const root={sub:new Map(),rows:[]};\r\n        for(const e of list){\r\n            let node=root, path='';\r\n            for(const seg of groupOf(e).split('/').filter(Boolean)){\r\n                path=path?path+'/'+seg:seg;\r\n                if(!node.sub.has(seg)){ const g={title:seg,path:path,sub:new Map(),rows:[]}; node.sub.set(seg,g); node.rows.push({group:g,order:e.order}); }\r\n                node=node.sub.get(seg);\r\n            }\r\n            node.rows.push({entry:e,order:e.order});\r\n        }\r\n        // a group with its own order (Settings → Navigation → Groups) moves there\r\n        (function sortNode(n){ for(const r of n.rows) if(r.group){ const o=parseFloat(groupCfg(r.group.path).order); if(!isNaN(o)) r.order=o; } n.rows.sort((a,b)=>a.order-b.order); for(const g of n.sub.values()) sortNode(g); })(root);\r\n        return root;\r\n    }\r\n    // Settings → Navigation → Groups: own title (a translation key works too), icon and order\r\n    const groupCfg=(path)=>(cfg.groups&&cfg.groups[path])||{};\r\n    const groupTitle=(g)=>{ const t=groupCfg(g.path).title||g.title; try{ const tr=IOB&&IOB.t?IOB.t(t):t; return tr&&tr!==t?tr:t; }catch(e){ return t; } };\r\n    // Icons only: a group opens its entries in a panel beside the sidebar (hover or click).\r\n    // The panel lives in the page (the sidebar clips what is inside it) and takes the menu's colours.\r\n    let fly=null, flyT=0;\r\n    const VARS=['--sb-bg','--sb-fg','--mi-bg','--mi-fg','--mi-hover','--mi-active','--mi-active-border','--mi-active-fg','--mi-active-icon'];\r\n    function closeFlyout(){ clearTimeout(flyT); if(fly){ fly.remove(); fly=null; } }\r\n    function closeSoon(){ clearTimeout(flyT); flyT=setTimeout(closeFlyout,280); }\r\n    function openFlyout(head, g){\r\n        clearTimeout(flyT);\r\n        if(fly&&fly._g===g) return;\r\n        closeFlyout();\r\n        fly=document.createElement('div'); fly._g=g; fly.className='nav-flyout';\r\n        const cs=getComputedStyle(instance); for(const v of VARS){ const x=cs.getPropertyValue(v); if(x&&x.trim()) fly.style.setProperty(v,x.trim()); }\r\n        const r=head.getBoundingClientRect(), sb=instance.getBoundingClientRect(), top=Math.max(8,r.top-8);\r\n        // beside a vertical menu (on its inner side), under a top bar, over a bottom bar\r\n        const place=horiz?(pos==='top'?{left:Math.max(6,r.left)+'px',top:(sb.bottom+6)+'px',maxHeight:(innerHeight-sb.bottom-18)+'px'}:{left:Math.max(6,r.left)+'px',bottom:(innerHeight-sb.top+6)+'px',maxHeight:(sb.top-18)+'px'})\r\n            :(pos==='right'?{right:(innerWidth-sb.left+6)+'px',top:top+'px',maxHeight:(innerHeight-top-12)+'px'}:{left:((state==='icons'?sb.left+ICONS_W:sb.right)+6)+'px',top:top+'px',maxHeight:(innerHeight-top-12)+'px'});\r\n        Object.assign(fly.style,place,{position:'fixed',zIndex:'100001',minWidth:'210px',maxWidth:'320px',overflow:'auto',padding:'6px 0 8px',borderRadius:'12px',background:'var(--sb-bg,linear-gradient(180deg,#1e3c72 0%,#2a5298 100%))',color:'var(--sb-fg,rgba(255,255,255,.9))',boxShadow:'0 10px 30px rgba(0,0,0,.38)'});\r\n        const h=document.createElement('div'); h.textContent=groupTitle(g); Object.assign(h.style,{padding:'8px 16px 6px',fontWeight:'700',fontSize:'13px',opacity:'.85',whiteSpace:'nowrap'}); fly.appendChild(h);\r\n        const current=(document.getElementById('viewer')||{}).screenName;\r\n        (function add(node, level){ for(const row of node.rows){\r\n            if(row.entry){ const mi=itemFor(row.entry, level); mi.compact=false; mi.selected=(row.entry.name===current); mi.addEventListener('menuitemclick',closeFlyout); fly.appendChild(mi); }\r\n            else { const sub=document.createElement('webui-navigation-menu-item'); sub.dataset.managed='1'; sub.kind='group'; sub.expanded=true; sub.title=groupTitle(row.group); sub.image=groupCfg(row.group.path).image||''; sub.level=level; sub.tint=cfg.tintIcons!==false; fly.appendChild(sub); add(row.group, level+1); }\r\n        } })(g, 0);\r\n        fly.addEventListener('mouseenter',()=>clearTimeout(flyT)); fly.addEventListener('mouseleave',closeSoon);\r\n        document.body.appendChild(fly);\r\n    }\r\n    if(!isDesigner){\r\n        // the runtime rebuilds the sidebar when the settings change: a removed sidebar lets go\r\n        const onDown=e=>{ if(!instance.isConnected){ document.removeEventListener('pointerdown',onDown,true); closeFlyout(); return; } if(fly&&!e.composedPath().some(n=>n===fly||n===instance)) closeFlyout(); };\r\n        const onKey=e=>{ if(!instance.isConnected){ document.removeEventListener('keydown',onKey); return; } if(e.key==='Escape') closeFlyout(); };\r\n        document.addEventListener('pointerdown',onDown,true);\r\n        document.addEventListener('keydown',onKey);\r\n    }\r\n    function drawNode(node, parent, level){\r\n        for(const r of node.rows){\r\n            if(r.entry){ parent.appendChild(itemFor(r.entry, level)); continue; }\r\n            const g=r.group, head=document.createElement('webui-navigation-menu-item'), box=document.createElement('div');\r\n            head.dataset.managed='1'; head.kind='group'; head.title=groupTitle(g); head.image=groupCfg(g.path).image||''; head.level=level; head.tint=cfg.tintIcons!==false; head.compact=(state==='icons');\r\n            head.expanded=!!openGroups[g.path];\r\n            box.dataset.group=g.path; box.hidden=!openGroups[g.path];\r\n            head.addEventListener('menugroupclick',()=>{ if(state==='icons'||horiz){ fly&&fly._g===g?closeFlyout():openFlyout(head,g); return; } box.hidden=!box.hidden; head.expanded=!box.hidden; openGroups[g.path]=!box.hidden; saveGroups(); });\r\n            head.addEventListener('mouseenter',()=>{ if(state==='icons'||horiz) openFlyout(head,g); });\r\n            head.addEventListener('mouseleave',()=>{ if(state==='icons'||horiz) closeSoon(); });\r\n            head._entries=(function all(n){ return n.rows.flatMap(x=>x.entry?[x.entry.name]:all(x.group)); })(g);\r\n            parent.appendChild(head); parent.appendChild(box);\r\n            drawNode(g, box, level+1);\r\n        }\r\n    }\r\n    // Badge: a screen's Navigation → Badge names a state; its value shows on the entry (a number,\r\n    // or a dot for true) and adds up on the group that holds it — an alarm count, for example.\r\n    const badgeVals=new Map(); let badgeSubs=[];\r\n    const badgeOf=(v)=>{ if(v===true||v==='true') return true; const n=Number(v); if(v!==''&&v!=null&&!isNaN(n)) return n>0?n:''; return (v==null||v===false||v==='false')?'':String(v); };\r\n    function showBadge(name){\r\n        const v=badgeVals.has(name)?badgeVals.get(name):'';\r\n        const sel='webui-navigation-menu-item[data-entry=\"'+CSS.escape(String(name))+'\"]';\r\n        for(const root of [items,fly]) if(root) root.querySelectorAll(sel).forEach(mi=>{ mi.badge=v; });\r\n        // groups: the sum of their numbers, or a dot when only dots\r\n        const heads=[]; for(const root of [items,fly]) if(root) root.querySelectorAll('webui-navigation-menu-item').forEach(h=>{ if(h.kind==='group'&&h._entries) heads.push(h); });\r\n        for(const h of heads){ let sum=0, dot=false; for(const n of h._entries){ const x=badgeVals.get(n); if(typeof x==='number') sum+=x; else if(x) dot=true; } h.badge=sum>0?sum:(dot?true:''); }\r\n    }\r\n    function watchBadges(list){\r\n        if(isDesigner||!IOB||!IOB.subscribeState) return;\r\n        for(const [id,cb] of badgeSubs) try{ IOB.unsubscribeState(id,cb); }catch(e){}\r\n        badgeSubs=[];\r\n        for(const e of list){\r\n            if(!e.badge) continue;\r\n            const cb=(_id,st)=>{ if(!instance.isConnected){ for(const [i,c] of badgeSubs) try{ IOB.unsubscribeState(i,c); }catch(x){} badgeSubs=[]; closeFlyout(); return; } badgeVals.set(e.name,badgeOf(st?st.val:'')); showBadge(e.name); };\r\n            IOB.subscribeState(e.badge,cb); badgeSubs.push([e.badge,cb]);\r\n            Promise.resolve(IOB.getState(e.badge)).then(st=>cb(e.badge,st)).catch(()=>{});\r\n        }\r\n    }\r\n    function draw(list){\r\n        hasItems=list.length>0;\r\n        if(items){ items.innerHTML='';\r\n            if(groupBy==='none') for(const e of list) items.appendChild(itemFor(e, 0));\r\n            else drawNode(tree(list), items, 0);\r\n            const sv=document.getElementById('viewer'); if(sv&&sv.screenName) setActive(sv.screenName);\r\n        }\r\n        watchBadges(list);\r\n        if(!isDesigner){ if(hasItems && !cfg.hideMenu) applyRuntimeLayout(); else { const v=document.getElementById('viewer'); if(v){ v.style.left='0'; v.style.width='100%'; } instance.style.display='none'; } }\r\n    }\r\n    // Position (left | right | top | bottom) and layout (push: the screen makes room; overlay: the\r\n    // menu opens over the screen, which keeps its size). An older \"horizontal\" orientation\r\n    // without a position means top. Top and bottom are a bar: groups open in a panel.\r\n    const pos=['left','right','top','bottom'].includes(cfg.position)?cfg.position:(cfg.orientation==='horizontal'?'top':'left');\r\n    const horiz=(pos==='top'||pos==='bottom');\r\n    const overlay=(cfg.layout==='overlay');\r\n    const BAR_H=56, BAR_ICONS_H=44;\r\n    if(horiz) instance.setAttribute('data-orient','h'); else instance.removeAttribute('data-orient');\r\n    let barTop=0;\r\n    function applyRuntimeLayout(){\r\n        const ab=document.getElementById('__nav-appbar-host'); barTop=ab?ab.offsetHeight:0;\r\n        const st=instance.style; st.position='fixed'; st.zIndex='99999'; st.overflow='hidden';\r\n        st.left=st.right=st.top=st.bottom='';\r\n        if(pos==='left'){ st.left='0'; st.top=barTop+'px'; st.bottom='0'; }\r\n        else if(pos==='right'){ st.right='0'; st.top=barTop+'px'; st.bottom='0'; }\r\n        else if(pos==='top'){ st.left='0'; st.right='0'; st.top=barTop+'px'; }\r\n        else { st.left='0'; st.right='0'; st.bottom='0'; }\r\n        if(!burger){\r\n            burger=document.createElement('div'); burger.id='__nav-burger'; burger.textContent='☰'; const inBar=barTop>0;\r\n            // the corner on the menu's side: in the app bar (a right menu: its right corner), or\r\n            // without an app bar over the page\r\n            const corner=inBar?(pos==='right'?'top:0;right:0;':'top:0;left:0;'):(pos==='right'?'top:8px;right:8px;':pos==='bottom'?'bottom:6px;left:8px;':'top:'+(pos==='top'?7:8)+'px;left:8px;');\r\n            burger.style.cssText='position:fixed;'+corner+'z-index:100002;width:'+(inBar?barTop:42)+'px;height:'+(inBar?barTop:42)+'px;display:flex;align-items:center;justify-content:center;font-size:22px;cursor:pointer;'+(inBar?'':'border-radius:8px;')+'background:'+(cfg.showButtonBg||(inBar?'transparent':'rgba(0,0,0,.45)'))+';color:'+(cfg.showButtonColor||'#fff')+';transition:background .15s;';\r\n            burger.onclick=cycle; document.body.appendChild(burger);\r\n        }\r\n        // the app bar keeps room for the ☰ on the side it sits on\r\n        const abEl=ab&&ab.querySelector('webui-navigation-app-bar');\r\n        if(abEl) abEl.style.setProperty('--bar-pad', pos==='right'?'0 '+(barTop+12)+'px 0 16px':'0 16px 0 '+(barTop+12)+'px');\r\n        // a bar without an app bar: the floating ☰ needs room at its start\r\n        st.paddingLeft=(horiz&&!barTop)?'56px':'';\r\n        setState(state);\r\n    }\r\n    // The sidebar and the screen move together, with the same easing: the screen's size\r\n    // changes every frame, so a stretched screen scales smoothly instead of jumping. The first\r\n    // placement is not animated.\r\n    const EASE='.32s cubic-bezier(.22,.8,.24,1)';\r\n    const still=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;\r\n    let placed=false;\r\n    function setState(s){\r\n        closeFlyout();\r\n        state=s;\r\n        if(startAs==='last'&&!isDesigner){ try{ localStorage.setItem(stateKey,s); }catch(e){} } const v=document.getElementById('viewer');\r\n        const anim=placed&&!still; placed=true;\r\n        instance.style.transition=anim?(horiz?'height ':'width ')+EASE+',transform '+EASE:'none';\r\n        if(v) v.style.transition=anim?['left','top','width','height'].map(p=>p+' '+EASE).join(','):'none';\r\n        const compact=(state==='icons');\r\n        if(items) items.querySelectorAll('webui-navigation-menu-item').forEach(mi=>{ mi.compact=compact; mi.toggleAttribute('data-h',horiz); });\r\n        // icons only, and any bar: a group's entries open in the panel, not under it\r\n        if(items) items.querySelectorAll('div[data-group]').forEach(box=>{ box.style.display=(compact||horiz)?'none':''; });\r\n        const hidden=(state==='hidden');\r\n        let size='0px';\r\n        if(state==='expanded'){ size=horiz?BAR_H+'px':navWidth; if(hdr)hdr.style.display=cfg.menuHeaderText?'':'none'; }\r\n        else if(state==='icons'){ size=(horiz?BAR_ICONS_H:ICONS_W)+'px'; if(hdr)hdr.style.display='none'; }\r\n        if(horiz){ instance.style.width=''; instance.style.height=size; instance.style.transform=''; }\r\n        else { instance.style.height=''; if(!hidden) instance.style.width=size; instance.style.transform=hidden?(pos==='right'?'translateX(110%)':'translateX(-110%)'):'translateX(0)'; }\r\n        if(v){\r\n            const room=(overlay||hidden)?'0px':size;\r\n            let l='0px', t=barTop+'px', w='100%', h='calc(100% - '+barTop+'px)';\r\n            if(pos==='left'){ l=room; w='calc(100% - '+room+')'; }\r\n            else if(pos==='right'){ w='calc(100% - '+room+')'; }\r\n            else if(pos==='top'){ t='calc('+barTop+'px + '+room+')'; h='calc(100% - '+barTop+'px - '+room+')'; }\r\n            else { h='calc(100% - '+barTop+'px - '+room+')'; }\r\n            v.style.left=l; v.style.top=t; v.style.width=w; v.style.height=h;\r\n        }\r\n    }\r\n    function cycle(){ const o=['expanded','icons','hidden']; let n=o[(o.indexOf(state)+1)%o.length]; if(n==='hidden'&&cfg.doNotHideCompletely)n='icons'; setState(n); }\r\n    wireSlot(instance._getDomElement('slotTop'), cfg, 'top');\r\n    wireSlot(instance._getDomElement('slotBottom'), cfg, 'bottom');\r\n    render();\r\n    if(IOB&&IOB.changeView) IOB.changeView.on(v=>setActive(v));\r\n    const sv=document.getElementById('viewer'); if(sv&&sv.screenName) setActive(sv.screenName);\r\n}"}