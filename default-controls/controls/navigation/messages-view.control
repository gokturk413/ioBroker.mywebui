{
 "properties": {},
 "settings": {
  "width": "720px",
  "height": "480px"
 },
 "html": "<div id=\"box\"></div>",
 "style": ":host{display:block;width:100%;height:100%;}\n#box{width:100%;height:100%;overflow:hidden;}",
 "script": "// Messages placed on the screen (no window). Its texts come from this\n// control's Translations (every language there, add more), then the project's and the built-in ones;\n// they follow the language at once when it changes.\nexport function init(instance) {\n    const box = instance._getDomElement('box');\n    if (!box || !window.IOB?.mountMessages) return;\n    instance._view = window.IOB.mountMessages(box);\n}\nexport function disconnectedCallback(instance) {\n    instance._view?.dispose();\n    instance._view = null;\n}\n",
 "translations": {
  "en": {
   "writeFeedback": {
    "pending": "Sent — waiting for the driver to confirm",
    "ok": "Confirmed by the driver",
    "same": "The value was already there — drivers do not confirm a non-change",
    "mismatch": "Confirmed with another value",
    "timeout": "No confirmation",
    "quality": "Confirmed with bad quality",
    "denied": "No write permission",
    "deniedShort": "denied",
    "refused": "The write was refused"
   },
   "msgs": {
    "title": "Messages",
    "ping": "Ping the changes",
    "gray": "Gray what shows no state",
    "altHint": "Hold Alt to see the states of the elements",
    "filter": "Filter: an element or a user",
    "filterAdmin": "Filter: an element, a state or a user",
    "pick": "Pick an element on the screen",
    "all": "All",
    "updates": "Updates",
    "commands": "Commands",
    "update": "update",
    "command": "command",
    "empty": "No messages yet",
    "foot": "{n} messages · {states} states since the page opened",
    "standsFor": "for {d}",
    "stood": "stood {d}",
    "waiting": "waiting for {by}",
    "restored": "back to {v}",
    "button": "Messages",
    "notAllowed": "Messages: not allowed for this user"
   }
  },
  "az": {
   "writeFeedback": {
    "pending": "Göndərildi — driver-in təsdiqi gözlənilir",
