{
 "properties": {},
 "settings": {
  "width": "900px",
  "height": "520px"
 },
 "html": "<div id=\"box\"></div>",
 "style": ":host{display:block;width:100%;height:100%;}\n#box{width:100%;height:100%;overflow:hidden;}",
 "script": "// Journal placed on the screen (no window). Its texts come from this\n// control's Translations (every language there, add more), then the project's and the built-in ones;\n// they follow the language at once when it changes.\nexport function init(instance) {\n    const box = instance._getDomElement('box');\n    if (!box || !window.IOB?.mountJournal) return;\n    instance._view = window.IOB.mountJournal(box);\n}\nexport function disconnectedCallback(instance) {\n    instance._view?.dispose();\n    instance._view = null;\n}\n",
