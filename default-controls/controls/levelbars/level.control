{"html": "<link rel=\"stylesheet\" href=\"https://www.w3schools.com/w3css/4/w3.css\">\n<div class=\"w3-border\" bind-css:width=\"??widget_width\" bind-css:height='{\"signal\":\"??widget_height\",\"expression\":\"var size = parseInt(__0, 10);\\r\\nreturn size +2 +\\\"px\\\";\"}' style=\"width:500px;position:absolute;height:52px;left:0px;top:0px;\">\n    <div bind-css:width=\"??barlevel\" bind-css:height=\"??widget_height\" bind-css:background=\"??back_color\" style=\"height:50px;width:0px;position:absolute;left:-1px;top:-1px;background:green;\"></div>\n</div>\n", "style": ":host {\n}\n\n* {\n    box-sizing: border-box;\n}", "script": "\nexport function init(instance) {\n\n   //instance._bindingsRefresh?.();\n   let lvvalue = instance._initialPropertyCache.get(\"barlevel\");\n   instance.barlevel=String(lvvalue)+\"px\";\n   //updateLevel(lvvalue, instance)\n   instance._assignEvent('barlevel-changed', (ev) => setlevelbarprop(ev.detail.newValue,instance));\n    /*setInterval(()=>{\n     let vcv = instance._bindings;\n      \n    },2000);*/\n}\n\nfunction setlevelbarprop(newValue,instance)\n{\n  let mx =  instance.max;\n  let mn =  instance.min;\n  let lvvalue= String(((newValue-mn)/(mx-mn))*100 );\n  instance.barlevel=lvvalue+\"px\";\n}\n\nexport function connectedCallback(instance) {\n\n   //instance._bindingsRefresh?.();\n   //updateLevel(instance.level, instance);\n}\n\n/**\n* @param {BaseScreenViewerAndControl} instance\n*/\nexport function disconnectedCallback(instance) {\n}", "properties": {"widget_height": {"type": "string", "default": "100px"}, "barlevel": {"type": "string"}, "widget_width": {"type": "string", "default": "100px"}, "back_color": {"type": "color", "default": "#FBD603"}, "min": {"type": "number", "default": "1"}, "max": {"type": "number", "default": "100"}}, "settings": {}}