{
 "properties": {
  "root": {
   "type": "signal",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_Motor"
  }
 },
 "settings": {
  "width": "48px",
  "height": "48px"
 },
 "html": "<div id=\"sym\" class=\"mt-sym\"><svg viewBox=\"0 0 40 40\" class=\"mt-ic\"><circle cx=\"20\" cy=\"20\" r=\"15\"/><path d=\"M20 8v6M20 26v6M8 20h6M26 20h6\"/></svg></div>",
 "style": ":host{display:block;width:100%;height:100%;}.mt-sym{width:100%;height:100%;min-width:36px;min-height:36px;cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:6px;background:var(--mt-bg,var(--ui-surface-2,#2f3545));border:1px solid var(--ui-border,#4a5570);}.mt-ic{width:70%;height:70%;fill:none;stroke:var(--ui-text,#e8e8ea);stroke-width:2;stroke-linecap:round;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action,element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n// wire symbol click -> open faceplate (event bindings can't eval expressions here, so bind imperatively)\nfunction ppWireSymbol(instance){\n  const el=instance._getDomElement&&instance._getDomElement('sym'); if(!el) return;\n  el.addEventListener('click',function(){ try{ window.IOB && window.IOB.openFaceplate && window.IOB.openFaceplate(instance.type,instance.root); }catch(e){} });\n}\n// wire faceplate header + icon tab-strip clicks imperatively\nfunction ppWireHeader(instance){\n  if(!instance._getDomElements) return;\n  for(const b of instance._getDomElements('.fp-x')){ b.addEventListener('click',function(){ try{ window.IOB && window.IOB.closeFaceplate && window.IOB.closeFaceplate(); }catch(e){} }); }\n  for(const b of instance._getDomElements('.fp-adv-btn')){ b.addEventListener('click',function(){ instance._adv&&instance._adv(); }); }\n  for(const t of instance._getDomElements('.fp-tab')){ (function(btn){ btn.addEventListener('click',function(){ const n=btn.getAttribute('data-tab'); if(n==='Main'){ instance._main&&instance._main(); } else { instance._tab&&instance._tab(n); } }); })(t); }\n}\n\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function') return;\n  instance.__s={};\n  const upd=function(){ const s=instance.__s; const el=instance._getDomElement('sym');\n    const col=(s.fault||s.tripped||s.failToStart||s.failToStop)?'var(--ui-error,#e5484d)':(s.running?'var(--ui-ok,#30a46c)':'var(--ui-surface-2,#2f3545)');\n    if(el) el.style.setProperty('--mt-bg',col); };\n  for(const f of ['running','fault','tripped','failToStart','failToStop']){ (function(name){\n    ppSubscribe(instance,name,function(v){ instance.__s[name]=(v===true||v==='true'||v===1); upd(); }); })(f); }\n  ppWireSymbol(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}