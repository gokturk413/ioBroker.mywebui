{
 "properties": {
  "root": {
   "type": "string",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  },
  "field": {
   "type": "string",
   "default": ""
  },
  "label": {
   "type": "string",
   "default": ""
  },
  "action": {
   "type": "string",
   "default": "operate"
  }
 },
 "settings": {
  "width": "120px",
  "height": "24px"
 },
 "html": "<div id=\"tg\" class=\"tg\"><span class=\"tg-lbl\">[[this.label||'']]</span><button id=\"sw\" class=\"tg-sw\" role=\"switch\"><span class=\"tg-knob\"></span></button></div>",
 "style": ":host{display:inline-block;font-family:'Segoe UI',sans-serif;color:var(--ui-text,#e8e8ea);}.tg{display:inline-flex;align-items:center;gap:8px;}.tg-lbl{font-size:12px;}.tg-sw{position:relative;width:38px;height:20px;border-radius:10px;border:none;cursor:pointer;background:var(--ui-surface-2,#4a5570);transition:background .2s;padding:0;}.tg-sw.on{background:var(--ui-ok,#30a46c);}.tg-knob{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:left .2s;}.tg-sw.on .tg-knob{left:20px;}.tg-sw:disabled{opacity:.4;cursor:not-allowed;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nfunction ppNum(v){ v=Number(v); return isFinite(v)&&Math.abs(v)<1e30 ? v : null; }\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action||'operate',element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\nfunction ppGate(instance,el,action){\n  const g=function(){ const ok=(window.IOB&&typeof window.IOB.secCan==='function')?window.IOB.secCan(action||'operate',instance):true; el.disabled=!ok; el.classList.toggle('pp-nogate',!ok); };\n  g(); try{ window.IOB&&window.IOB.securityChanged&&window.IOB.securityChanged.on&&window.IOB.securityChanged.on(g); }catch(e){}\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n\nfunction tgApply(instance){ const sw=instance._getDomElement('sw'); if(sw) sw.classList.toggle('on', instance.__on===true); }\nfunction tgStart(instance){\n  ppCleanup(instance);\n  const sw=instance._getDomElement('sw'); if(sw) ppGate(instance,sw,instance.action||'operate');\n  if(!instance.root||!instance.field){ tgApply(instance); return; }\n  ppSubscribe(instance,instance.field,function(v){ instance.__on=(v===true||v==='true'||v===1); tgApply(instance); });\n}\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function') return;\n  instance._ppReinit=function(){ tgStart(instance); };\n  const sw=instance._getDomElement('sw');\n  if(sw) sw.addEventListener('click',function(){ if(sw.disabled) return; ppWrite(instance,instance.field,!(instance.__on===true),instance.action||'operate'); });\n  tgStart(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}