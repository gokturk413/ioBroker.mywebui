{
 "properties": {
  "root": {
   "type": "string",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  },
  "unit": {
   "type": "string",
   "default": ""
  },
  "decimals": {
   "type": "number",
   "default": 2
  }
 },
 "settings": {
  "width": "120px",
  "height": "210px"
 },
 "html": "<div id=\"lb\" class=\"lb\"><div id=\"scale\" class=\"lb-scale\"><div id=\"fill\" class=\"lb-fill\"></div><div id=\"mk-hihi\" class=\"lb-mk hihi\"><span class=\"lb-mv\" id=\"mv-hihi\"></span></div><div id=\"mk-hi\" class=\"lb-mk hi\"><span class=\"lb-mv\" id=\"mv-hi\"></span></div><div id=\"mk-lo\" class=\"lb-mk lo\"><span class=\"lb-mv\" id=\"mv-lo\"></span></div><div id=\"mk-lolo\" class=\"lb-mk lolo\"><span class=\"lb-mv\" id=\"mv-lolo\"></span></div><div id=\"ptr\" class=\"lb-ptr\"><span id=\"ptrval\"></span></div></div></div>",
 "style": ":host{display:block;font-family:'Segoe UI',sans-serif;color:var(--ui-text,#e8e8ea);}.lb{display:flex;justify-content:center;padding:6px 2px;}.lb-scale{position:relative;width:46px;height:190px;border-radius:5px;background:linear-gradient(var(--ui-surface-2,#2f3545),color-mix(in srgb,var(--ui-surface-2,#2f3545) 55%,transparent));border:1px solid var(--ui-border,#4a5570);overflow:visible;}.lb-fill{position:absolute;left:0;right:0;bottom:0;height:0%;border-radius:0 0 4px 4px;background:var(--lb-col,var(--ui-ok,#30a46c));opacity:.9;transition:height .25s,background .25s;}.lb-mk{position:absolute;left:-2px;right:-2px;height:0;border-top:2px dashed;z-index:2;}.lb-mv{position:absolute;left:calc(100% + 6px);top:-8px;font:10px monospace;white-space:nowrap;}.lb-mk.hihi,.lb-mk.lolo{border-color:var(--ui-error,#e5484d);color:var(--ui-error,#e5484d);}.lb-mk.hi,.lb-mk.lo{border-color:var(--ui-warn,#f6b73c);color:var(--ui-warn,#f6b73c);}.lb-ptr{position:absolute;left:-3px;right:-3px;height:2px;background:var(--ui-text,#e8e8ea);z-index:3;transition:bottom .25s;}.lb-ptr span{position:absolute;right:calc(100% + 5px);top:-8px;font:600 10px monospace;white-space:nowrap;color:var(--ui-text,#e8e8ea);}.lb-mk.off,.lb-ptr.off{display:none;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nfunction ppNum(v){ v=Number(v); return isFinite(v)&&Math.abs(v)<1e30 ? v : null; }\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action||'operate',element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\nfunction ppGate(instance,el,action){\n  const g=function(){ const ok=(window.IOB&&typeof window.IOB.secCan==='function')?window.IOB.secCan(action||'operate',instance):true; el.disabled=!ok; el.classList.toggle('pp-nogate',!ok); };\n  g(); try{ window.IOB&&window.IOB.securityChanged&&window.IOB.securityChanged.on&&window.IOB.securityChanged.on(g); }catch(e){}\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n\nfunction lbApply(instance){\n  if(typeof instance._getDomElement!=='function') return;\n  const min=ppNum(instance.pvEuMin), max=ppNum(instance.pvEuMax), pv=ppNum(instance.pv);\n  const span=(min!=null&&max!=null&&max>min)?(max-min):null;\n  // percent from the BOTTOM of the scale (bottom=min, top=max)\n  const pct=(v)=>{ if(v==null||span==null) return null; return Math.max(0,Math.min(100,(v-min)/span*100)); };\n  const dp=(instance.decimals!=null)?Number(instance.decimals):1;\n  // markers: position by limit value, print the EU value beside each\n  const mk=(mid,vid,v)=>{ const el=instance._getDomElement(mid), lab=instance._getDomElement(vid);\n    const p=pct(v);\n    if(el){ if(p==null){ el.classList.add('off'); } else { el.classList.remove('off'); el.style.bottom=p+'%'; } }\n    if(lab) lab.textContent=(v==null)?'':Number(v).toFixed(0); };\n  mk('mk-hihi','mv-hihi',ppNum(instance.hiHiLim));\n  mk('mk-hi','mv-hi',ppNum(instance.hiLim));\n  mk('mk-lo','mv-lo',ppNum(instance.loLim));\n  mk('mk-lolo','mv-lolo',ppNum(instance.loLoLim));\n  // fill + pointer\n  const fp=pct(pv), fill=instance._getDomElement('fill'), ptr=instance._getDomElement('ptr'), pval=instance._getDomElement('ptrval');\n  if(fill) fill.style.height=(fp==null?0:fp)+'%';\n  if(ptr){ if(fp==null){ ptr.classList.add('off'); } else { ptr.classList.remove('off'); ptr.style.bottom=fp+'%'; } }\n  if(pval) pval.textContent=(pv==null)?'':pv.toFixed(dp);\n  // fill colour: highest active threshold (computed from PV vs limits; falls back to alarm flags)\n  const A=instance.__alm||{};\n  const hh=ppNum(instance.hiHiLim), ll=ppNum(instance.loLoLim), h=ppNum(instance.hiLim), l=ppNum(instance.loLim);\n  let crit=A.hiHiAlarm||A.loLoAlarm||A.failAlarm, warn=A.hiAlarm||A.loAlarm;\n  if(pv!=null){ if((hh!=null&&pv>=hh)||(ll!=null&&pv<=ll)) crit=true; else if((h!=null&&pv>=h)||(l!=null&&pv<=l)) warn=true; }\n  const col=crit?'var(--ui-error,#e5484d)':(warn?'var(--ui-warn,#f6b73c)':'var(--ui-ok,#30a46c)');\n  const lb=instance._getDomElement('lb'); if(lb) lb.style.setProperty('--lb-col',col);\n}\nfunction lbStart(instance){\n  ppCleanup(instance);\n  instance.__alm={};\n  if(!instance.root){ lbApply(instance); return; }\n  const F=['pv','pvEuMin','pvEuMax','hiHiLim','hiLim','loLim','loLoLim'];\n  for(const f of F){ (function(field){ ppSubscribe(instance,field,function(v){ instance[field]=v; lbApply(instance); }); })(f); }\n  const AL=['hiHiAlarm','hiAlarm','loAlarm','loLoAlarm','failAlarm'];\n  for(const a of AL){ (function(name){ ppSubscribe(instance,name,function(v){ instance.__alm[name]=(v===true||v==='true'||v===1); lbApply(instance); }); })(a); }\n  lbApply(instance);\n}\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function' || typeof instance._getDomElements!=='function') return;\n  instance._ppReinit=function(){ lbStart(instance); };\n  lbStart(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}