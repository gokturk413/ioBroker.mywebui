{
 "properties": {
  "root": {
   "type": "string",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  },
  "field": {
   "type": "string",
   "default": "pv"
  },
  "points": {
   "type": "number",
   "default": 60
  }
 },
 "settings": {
  "width": "280px",
  "height": "40px"
 },
 "html": "<div id=\"sp\" class=\"sp\"><svg id=\"svg\" class=\"sp-svg\" preserveAspectRatio=\"none\" viewBox=\"0 0 100 30\"><polyline id=\"pl\" class=\"sp-line\" points=\"\"></polyline></svg></div>",
 "style": ":host{display:block;width:100%;height:100%;}.sp{width:100%;height:100%;min-height:34px;background:var(--ui-surface-2,#2f3545);border:1px solid var(--ui-border,#4a5570);border-radius:4px;box-sizing:border-box;padding:2px;}.sp-svg{width:100%;height:100%;display:block;}.sp-line{fill:none;stroke:var(--sp-col,var(--accent,#2680eb));stroke-width:1.5;vector-effect:non-scaling-stroke;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nfunction ppNum(v){ v=Number(v); return isFinite(v)&&Math.abs(v)<1e30 ? v : null; }\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action||'operate',element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\nfunction ppGate(instance,el,action){\n  const g=function(){ const ok=(window.IOB&&typeof window.IOB.secCan==='function')?window.IOB.secCan(action||'operate',instance):true; el.disabled=!ok; el.classList.toggle('pp-nogate',!ok); };\n  g(); try{ window.IOB&&window.IOB.securityChanged&&window.IOB.securityChanged.on&&window.IOB.securityChanged.on(g); }catch(e){}\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n\nfunction spDraw(instance){\n  const buf=instance.__buf||[]; if(!buf.length) return;\n  const pl=instance._getDomElement('pl'); if(!pl) return;\n  let lo=Math.min.apply(null,buf), hi=Math.max.apply(null,buf);\n  if(hi<=lo) hi=lo+1;\n  const n=buf.length, W=100, H=30;\n  const pts=buf.map(function(v,i){ const x=(n<2)?0:(i/(n-1)*W); const y=H-((v-lo)/(hi-lo)*H); return x.toFixed(2)+','+y.toFixed(2); });\n  pl.setAttribute('points', pts.join(' '));\n}\nfunction spStart(instance){\n  ppCleanup(instance); instance.__buf=[];\n  if(!instance.root) return;\n  const cap=Number(instance.points)||60;\n  ppSubscribe(instance,instance.field||'pv',function(v){\n    v=Number(v); if(!isFinite(v)) return;\n    instance.__buf.push(v); if(instance.__buf.length>cap) instance.__buf.shift();\n    spDraw(instance);\n  });\n}\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function') return;\n  instance._ppReinit=function(){ spStart(instance); };\n  spStart(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}