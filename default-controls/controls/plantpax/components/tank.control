{
 "properties": {
  "root": {
   "type": "string",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  }
 },
 "settings": {
  "width": "56px",
  "height": "84px"
 },
 "html": "<div id=\"tk\" class=\"tk\"><svg viewBox=\"0 0 60 90\" class=\"tk-svg\" preserveAspectRatio=\"none\"><clipPath id=\"tkc\"><rect x=\"6\" y=\"8\" width=\"48\" height=\"74\" rx=\"6\"/></clipPath><rect id=\"fill\" x=\"6\" y=\"82\" width=\"48\" height=\"0\" clip-path=\"url(#tkc)\" class=\"tk-fill\"></rect><rect x=\"6\" y=\"8\" width=\"48\" height=\"74\" rx=\"6\" class=\"tk-out\"/></svg><span id=\"pvt\" class=\"tk-pv\">--</span></div>",
 "style": ":host{display:block;width:100%;height:100%;font-family:'Segoe UI',sans-serif;}.tk{position:relative;width:100%;height:100%;min-width:44px;min-height:64px;cursor:pointer;}.tk-svg{width:100%;height:100%;display:block;}.tk-out{fill:none;stroke:var(--ui-border,#4a5570);stroke-width:2;}.tk-fill{fill:var(--tk-col,var(--ui-ok,#30a46c));transition:y .3s,height .3s,fill .3s;}.tk-pv{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:12px;font-weight:700;color:var(--ui-text,#e8e8ea);text-shadow:0 1px 2px rgba(0,0,0,.6);pointer-events:none;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nfunction ppNum(v){ v=Number(v); return isFinite(v)&&Math.abs(v)<1e30 ? v : null; }\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action||'operate',element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\nfunction ppGate(instance,el,action){\n  const g=function(){ const ok=(window.IOB&&typeof window.IOB.secCan==='function')?window.IOB.secCan(action||'operate',instance):true; el.disabled=!ok; el.classList.toggle('pp-nogate',!ok); };\n  g(); try{ window.IOB&&window.IOB.securityChanged&&window.IOB.securityChanged.on&&window.IOB.securityChanged.on(g); }catch(e){}\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n\nfunction tkApply(instance){\n  const min=ppNum(instance.pvEuMin), max=ppNum(instance.pvEuMax), pv=ppNum(instance.pv);\n  const fill=instance._getDomElement('fill'), pvt=instance._getDomElement('pvt'), tk=instance._getDomElement('tk');\n  if(fill && min!=null && max!=null && max>min && pv!=null){\n    let p=Math.max(0,Math.min(1,(pv-min)/(max-min)));\n    const top=8, full=74, h=full*p;\n    fill.setAttribute('y',(top+full-h).toFixed(1)); fill.setAttribute('height',h.toFixed(1));\n  }\n  if(pvt) pvt.textContent=(pv==null)?'--':pv.toFixed(1);\n  const A=instance.__alm||{};\n  const col=(A.hiHiAlarm||A.loLoAlarm||A.failAlarm)?'var(--ui-error,#e5484d)':((A.hiAlarm||A.loAlarm)?'var(--ui-warn,#f6b73c)':'var(--ui-ok,#30a46c)');\n  if(tk) tk.style.setProperty('--tk-col',col);\n}\nfunction tkStart(instance){\n  ppCleanup(instance); instance.__alm={};\n  if(!instance.root){ tkApply(instance); return; }\n  for(const f of ['pv','pvEuMin','pvEuMax']){ (function(field){ ppSubscribe(instance,field,function(v){ instance[field]=v; tkApply(instance); }); })(f); }\n  for(const a of ['hiHiAlarm','hiAlarm','loAlarm','loLoAlarm','failAlarm']){ (function(name){ ppSubscribe(instance,name,function(v){ instance.__alm[name]=(v===true||v==='true'||v===1); tkApply(instance); }); })(a); }\n}\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function') return;\n  instance._ppReinit=function(){ tkStart(instance); };\n  const tk=instance._getDomElement('tk');\n  if(tk) tk.addEventListener('click',function(){ try{ window.IOB && window.IOB.openFaceplate && window.IOB.openFaceplate(instance.type,instance.root); }catch(e){} });\n  tkStart(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}