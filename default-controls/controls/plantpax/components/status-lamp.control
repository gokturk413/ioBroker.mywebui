{
 "properties": {
  "root": {
   "type": "string",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  },
  "field": {
   "type": "string",
   "default": ""
  },
  "label": {
   "type": "string",
   "default": ""
  },
  "oncolor": {
   "type": "color",
   "default": ""
  },
  "offcolor": {
   "type": "color",
   "default": ""
  }
 },
 "settings": {
  "width": "90px",
  "height": "20px"
 },
 "html": "<div id=\"lp\" class=\"lp\"><span id=\"dot\" class=\"lp-dot\"></span><span id=\"lbl\" class=\"lp-lbl\">[[this.label||'']]</span></div>",
 "style": ":host{display:inline-block;font-family:'Segoe UI',sans-serif;color:var(--ui-text,#e8e8ea);}.lp{display:inline-flex;align-items:center;gap:6px;}.lp-dot{width:12px;height:12px;border-radius:50%;background:var(--lp-col,var(--ui-dim,#6b7280));box-shadow:0 0 4px var(--lp-col,transparent);transition:background .2s;}.lp-lbl{font-size:12px;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nfunction ppNum(v){ v=Number(v); return isFinite(v)&&Math.abs(v)<1e30 ? v : null; }\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action||'operate',element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\nfunction ppGate(instance,el,action){\n  const g=function(){ const ok=(window.IOB&&typeof window.IOB.secCan==='function')?window.IOB.secCan(action||'operate',instance):true; el.disabled=!ok; el.classList.toggle('pp-nogate',!ok); };\n  g(); try{ window.IOB&&window.IOB.securityChanged&&window.IOB.securityChanged.on&&window.IOB.securityChanged.on(g); }catch(e){}\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n\nfunction lpApply(instance){\n  const on=instance.__on===true;\n  const col= on ? (instance.oncolor||'var(--ui-ok,#30a46c)') : (instance.offcolor||'var(--ui-dim,#4a5570)');\n  const el=instance._getDomElement('dot'); if(el) el.style.setProperty('--lp-col', col);\n}\nfunction lpStart(instance){\n  ppCleanup(instance);\n  if(!instance.root||!instance.field){ lpApply(instance); return; }\n  ppHideIfMissing(instance,instance.field,instance._getDomElement('lp'));\n  ppSubscribe(instance,instance.field,function(v){ instance.__on=(v===true||v==='true'||v===1); lpApply(instance); });\n}\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function') return;\n  instance._ppReinit=function(){ lpStart(instance); };\n  lpStart(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}