{
 "properties": {
  "root": {
   "type": "signal",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_PIDE"
  }
 },
 "settings": {
  "width": "48px",
  "height": "40px"
 },
 "html": "<div id=\"sym\" class=\"dv-sym\"><span class=\"dv-ab\">PID</span></div>",
 "style": ":host{display:block;width:100%;height:100%;font-family:'Segoe UI',sans-serif;}.dv-sym{width:100%;height:100%;min-width:40px;min-height:34px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ui-text,#e8e8ea);font-weight:700;font-size:13px;}.dv-sym .dv-ab{display:flex;align-items:center;justify-content:center;width:100%;height:100%;border-radius:5px;background:var(--dv-fill,var(--ui-surface-2,#2f3545));border:1px solid var(--ui-border,#4a5570);}.dv-svg{width:100%;height:100%;}.dv-fill{fill:var(--dv-fill,var(--ui-surface-2,#2f3545));transition:fill .25s;}.dv-out{stroke:var(--ui-text,#cfd6df);stroke-width:1.6;fill:none;stroke-linejoin:round;}rect.dv-fill,path.dv-fill{stroke:none;}.dv-txt{fill:var(--ui-text,#e8e8ea);font:700 15px 'Segoe UI',sans-serif;text-anchor:middle;}.dv-dot{fill:var(--dv-dot,var(--ui-border,#4a5570));transition:fill .25s;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action,element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n// wire symbol click -> open faceplate (event bindings can't eval expressions here, so bind imperatively)\nfunction ppWireSymbol(instance){\n  const el=instance._getDomElement&&instance._getDomElement('sym'); if(!el) return;\n  el.addEventListener('click',function(){ try{ window.IOB && window.IOB.openFaceplate && window.IOB.openFaceplate(instance.type,instance.root); }catch(e){} });\n}\n// wire faceplate header + icon tab-strip clicks imperatively\nfunction ppWireHeader(instance){\n  if(!instance._getDomElements) return;\n  for(const b of instance._getDomElements('.fp-x')){ b.addEventListener('click',function(){ try{ window.IOB && window.IOB.closeFaceplate && window.IOB.closeFaceplate(); }catch(e){} }); }\n  for(const b of instance._getDomElements('.fp-adv-btn')){ b.addEventListener('click',function(){ instance._adv&&instance._adv(); }); }\n  for(const t of instance._getDomElements('.fp-tab')){ (function(btn){ btn.addEventListener('click',function(){ const n=btn.getAttribute('data-tab'); if(n==='Main'){ instance._main&&instance._main(); } else { instance._tab&&instance._tab(n); } }); })(t); }\n}\n\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function') return;\n  instance.__s={};\n  const CF=[\"modeOverride\"];\n  const upd=function(){ const s=instance.__s; let bad=false,on=false;\n    for(const f of CF){ if(s[f]){ if(/fault|trip|fail|ioFault|disagree/i.test(f)) bad=true; else on=true; } }\n    const el=instance._getDomElement('sym'); if(!el) return;\n    const c = bad?'var(--ui-error,#e5484d)':(on?'var(--ui-ok,#30a46c)':'var(--ui-surface-2,#2f3545)');\n    el.style.setProperty('--dv-fill', c);\n    el.style.setProperty('--dv-dot', bad?'var(--ui-error,#e5484d)':(on?'var(--ui-ok,#30a46c)':'var(--ui-border,#4a5570)')); };\n  for(const f of CF){ (function(name){ ppSubscribe(instance,name,function(v){ instance.__s[name]=(v===true||v==='true'||v===1); upd(); }); })(f); }\n  ppWireSymbol(instance);\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}