{
 "properties": {
  "root": {
   "type": "signal",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_Gate"
  }
 },
 "settings": {
  "width": "380px",
  "height": "560px"
 },
 "html": "<div class=\"fp\"><div class=\"fp-hdr\"><span class=\"fp-title\">[[this.root]]</span><button class=\"fp-x\">✕</button></div><div class=\"fp-body\"><div class=\"fp-sec\">Inputs</div><div class=\"mt-lamps\"><webui-plantpax-components-status-lamp data-pp=\"1\" field=\"inp\" label=\"Input\" oncolor=\"var(--accent,#2680eb)\"></webui-plantpax-components-status-lamp><webui-plantpax-components-status-lamp data-pp=\"1\" field=\"inpGate\" label=\"Gate Input\" oncolor=\"var(--accent,#2680eb)\"></webui-plantpax-components-status-lamp></div><div class=\"gt-arrow\">▼</div><div class=\"fp-sec\">Gate — condition &amp; delay</div><div class=\"mt-lamps\"><webui-plantpax-components-status-lamp data-pp=\"1\" field=\"gated\" label=\"Gate Open\" oncolor=\"var(--ui-ok,#30a46c)\"></webui-plantpax-components-status-lamp></div><div class=\"fp-row\" data-gate=\"gateDly\"><span class=\"lbl cfg\"><b>Gate Delay</b><span class=\"cfgmem\">Cfg_GateDly</span></span><span class=\"gt-acc\">[[this.gateAcc==null?'':(Number(this.gateAcc)/1000).toFixed(1)+' s']]</span><input type=\"number\" step=\"0.1\" min=\"0\" data-field=\"gateDly\"><span class=\"cfgunit\">s</span></div><div class=\"gt-arrow\">▼</div><div class=\"fp-sec\">Output Delay</div><div class=\"fp-row\" data-gate=\"onDly\"><span class=\"lbl cfg\"><b>On Delay</b><span class=\"cfgmem\">Cfg_OnDly</span></span><span class=\"gt-acc\">[[this.onAcc==null?'':(Number(this.onAcc)/1000).toFixed(1)+' s']]</span><input type=\"number\" step=\"0.1\" min=\"0\" data-field=\"onDly\"><span class=\"cfgunit\">s</span></div><div class=\"fp-row\" data-gate=\"offDly\"><span class=\"lbl cfg\"><b>Off Delay</b><span class=\"cfgmem\">Cfg_OffDly</span></span><span class=\"gt-acc\">[[this.offAcc==null?'':(Number(this.offAcc)/1000).toFixed(1)+' s']]</span><input type=\"number\" step=\"0.1\" min=\"0\" data-field=\"offDly\"><span class=\"cfgunit\">s</span></div><div class=\"gt-arrow\">▼</div><div class=\"fp-sec\">Output</div><div class=\"mt-lamps\"><webui-plantpax-components-status-lamp data-pp=\"1\" field=\"out\" label=\"Output\" oncolor=\"var(--ui-ok,#30a46c)\"></webui-plantpax-components-status-lamp></div><div class=\"fp-flags\"><webui-plantpax-components-status-flag data-pp=\"1\" field=\"stsErr\" label=\"Cfg Error\" tone=\"error\"></webui-plantpax-components-status-flag><webui-plantpax-components-status-flag data-pp=\"1\" field=\"errTimer\" label=\"Timer Cfg Error\" tone=\"error\"></webui-plantpax-components-status-flag></div></div></div>",
 "style": ":host{display:block;font-family:'Segoe UI',sans-serif;color:var(--ui-text,#e8e8ea);}.fp{display:flex;flex-direction:column;min-width:340px;font-size:13px;background:var(--ui-surface,#1a212b);border-radius:8px;overflow:hidden;}.fp-hdr{display:flex;align-items:center;gap:8px;padding:11px 13px;background:var(--ui-surface-2,#232e3d);}.fp-title{font-weight:640;flex:1;font-size:13px;font-family:monospace;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.fp-x{cursor:pointer;background:none;border:none;color:var(--ui-text,#e8e8ea);font-size:15px;opacity:.85;padding:2px 7px;border-radius:4px;}.fp-x:hover{background:rgba(255,255,255,.1);}.fp-adv-btn{cursor:pointer;background:none;border:none;color:var(--ui-text,#e8e8ea);opacity:.85;padding:3px;display:flex;border-radius:4px;}.fp-adv-btn:hover{background:rgba(255,255,255,.1);}.fp-desc{padding:6px 13px;font-size:11.5px;color:var(--ui-dim,#9aa4b2);border-bottom:1px solid var(--ui-border,#2b3542);}.fp-tabs{display:flex;background:var(--ui-surface-2,#1e2732);border-bottom:1px solid var(--ui-border,#2b3542);}.fp-tab{flex:1;position:relative;padding:8px 2px;cursor:pointer;background:none;border:none;color:var(--ui-dim,#9aa4b2);display:flex;flex-direction:column;align-items:center;gap:3px;border-right:1px solid var(--ui-border,#222b36);}.fp-tab:last-child{border-right:none;}.fp-tab:hover{color:var(--ui-text,#e8e8ea);}.fp-tab.sel{color:var(--accent,#5b9bff);background:var(--ui-surface,#1a212b);}.fp-tab.sel::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--accent,#5b9bff);}.fp-tab-cap{font-size:9px;letter-spacing:.02em;}.fp-ic{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}.fp-tab-badge{position:absolute;top:5px;right:calc(50% - 15px);width:7px;height:7px;border-radius:50%;background:var(--ui-error,#e5484d);}.fp-body{padding:14px 15px;}.fp-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 0;border-top:1px solid var(--ui-border,#222b36);font-size:12.5px;}.fp-row:first-child{border-top:none;}.fp-row .lbl{opacity:.7;}.fp-row input{width:90px;flex:none;text-align:right;padding:4px 8px;background:var(--ui-surface-2,#2f3545);color:var(--ui-text,#e8e8ea);border:1px solid var(--ui-border,#4a5570);border-radius:4px;font-family:monospace;}.fp-btn{padding:5px 11px;background:var(--accent,#2680eb);color:#fff;border:none;border-radius:5px;cursor:pointer;font-size:11px;}.fp-btn.ghost{background:none;border:1px solid var(--ui-border,#4a5570);color:var(--ui-text,#e8e8ea);}.fp-alm{display:flex;align-items:center;gap:8px;margin-bottom:6px;}.fp-chip{width:12px;height:12px;border-radius:50%;background:var(--ui-ok,#30a46c);}.fp-alm.active .fp-chip{background:var(--ui-error,#e5484d);}.fp-alm .nm{flex:1;font-size:12px;}.fp-mai{display:flex;gap:16px;align-items:stretch;}.fp-mai webui-plantpax-components-level-bar{flex:none;}.fp-pv{flex:1;display:flex;flex-direction:column;}.pv-big{font-size:36px;font-weight:710;letter-spacing:-.02em;line-height:1;}.pv-eu{font-size:12px;opacity:.7;margin:3px 0 8px;}.pv-mem{font-family:monospace;font-size:10px;color:var(--accent,#5b9bff);opacity:.8;}.fp-flags{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}.fp-sec{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ui-dim,#9aa4b2);margin:14px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--ui-border,#222b36);}.fp-sec:first-child{margin-top:2px;}.fp-mrow{display:flex;align-items:center;gap:8px;margin-bottom:5px;}.fp-mrow .mnm{width:44px;font-size:12px;opacity:.8;}.fp-mrow .mh{flex:1;text-align:center;font-size:10px;opacity:.6;text-transform:uppercase;}.fp-mrow.head{margin-bottom:6px;}.fp-mrow input.mnum{flex:1;width:0;padding:4px;background:var(--ui-surface-2,#2f3545);color:var(--ui-text,#e8e8ea);border:1px solid var(--ui-border,#4a5570);border-radius:4px;font-size:12px;}.fp-chk{display:flex;align-items:center;gap:8px;font-size:12.5px;margin:8px 0;cursor:pointer;}.fp-chk .m{margin-left:auto;font-family:monospace;font-size:9.5px;color:var(--accent,#5b9bff);opacity:.75;}.fp-row .lbl.cfg{display:flex;flex-direction:column;gap:1px;opacity:1;}.fp-row .lbl.cfg b{font-weight:500;font-size:12.5px;}.cfgmem{font-family:monospace;font-size:9.5px;color:var(--accent,#5b9bff);opacity:.75;}.cfgunit{font-family:monospace;font-size:11px;color:var(--ui-dim,#9aa4b2);margin-left:6px;}.fp-almbar{display:flex;align-items:center;gap:8px;margin-bottom:12px;}.fp-grow{flex:1;}.fp-unack{font-size:12px;color:var(--ui-error,#e5484d);font-weight:600;}.fp-cmdimg{width:34px;height:34px;cursor:pointer;flex:none;margin-left:4px;border-radius:4px;}.fp-cmdimg:hover{background:rgba(255,255,255,.08);}.qual{font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:6px;}.qual::after{content:'';width:8px;height:8px;border-radius:50%;background:currentColor;order:2;}.qual.good{color:var(--ui-ok,#30a46c);}.qual.unc{color:var(--ui-warn,#f6b73c);}.qual.bad{color:var(--ui-error,#e5484d);}.hidden{display:none!important;}.mt-lamps{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}.mt-cmds{display:flex;gap:10px;margin:10px 0;}.mt-cmds webui-plantpax-components-command-button{flex:1;}.mt-mode{display:flex;align-items:center;gap:8px;font-size:12px;margin-top:8px;}.mt-mode .badge{padding:3px 10px;border-radius:10px;font-weight:700;font-size:11px;background:var(--ui-surface-2,#2f3545);}.gt-arrow{text-align:center;font-size:11px;opacity:.45;margin:2px 0;}.gt-acc{font-family:monospace;font-size:11px;color:var(--accent,#5b9bff);opacity:.85;margin-left:auto;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action,element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n// wire symbol click -> open faceplate (event bindings can't eval expressions here, so bind imperatively)\nfunction ppWireSymbol(instance){\n  const el=instance._getDomElement&&instance._getDomElement('sym'); if(!el) return;\n  el.addEventListener('click',function(){ try{ window.IOB && window.IOB.openFaceplate && window.IOB.openFaceplate(instance.type,instance.root); }catch(e){} });\n}\n// wire faceplate header + icon tab-strip clicks imperatively\nfunction ppWireHeader(instance){\n  if(!instance._getDomElements) return;\n  for(const b of instance._getDomElements('.fp-x')){ b.addEventListener('click',function(){ try{ window.IOB && window.IOB.closeFaceplate && window.IOB.closeFaceplate(); }catch(e){} }); }\n  for(const b of instance._getDomElements('.fp-adv-btn')){ b.addEventListener('click',function(){ instance._adv&&instance._adv(); }); }\n  for(const t of instance._getDomElements('.fp-tab')){ (function(btn){ btn.addEventListener('click',function(){ const n=btn.getAttribute('data-tab'); if(n==='Main'){ instance._main&&instance._main(); } else { instance._tab&&instance._tab(n); } }); })(t); }\n}\n\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function' || typeof instance._getDomElements!=='function') return;\n  // fill timer-preset inputs imperatively (bind-prop:value + [[..]] does not reach\n  // input.value, see faceplate_script note); skip while the operator is typing.\n  const setNum=function(field,v){ for(const inp of instance._getDomElements('input[data-field=\"'+field+'\"]')){ if(!inp.matches(':focus')) inp.value=(v===null||v===undefined)?'':v; } };\n  for(const f of ['gateDly','onDly','offDly','gateAcc','onAcc','offAcc']){\n    (function(field){ ppSubscribe(instance,field,function(v){ instance[field]=v; setNum(field,v); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} }); })(f); }\n  ppWireHeader(instance);\n  for(const c of instance._getDomElements('[data-pp]')){ c.root=instance.root; c.type=instance.type;\n    if(typeof c._ppReinit==='function'){ c._ppReinit(); } else { (function(cc){ setTimeout(function(){ cc._ppReinit&&cc._ppReinit(); },200); })(c); } }\n  for(const el of instance._getDomElements('[data-gate]')) ppHideIfMissing(instance,el.getAttribute('data-gate'),el);\n  for(const i of instance._getDomElements('[data-field]')){\n    (function(inp){ inp.addEventListener('change',function(){ ppWrite(instance,inp.getAttribute('data-field'),Number(inp.value),'configure'); }); })(i);\n  }\n  const gate=function(){ const ok=(window.IOB&&typeof window.IOB.secCan==='function')?window.IOB.secCan('configure',instance):true;\n    for(const i of instance._getDomElements('[data-field]')) i.disabled=!ok; };\n  gate();\n  try{ window.IOB && window.IOB.securityChanged && window.IOB.securityChanged.on && window.IOB.securityChanged.on(gate); }catch(e){}\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}