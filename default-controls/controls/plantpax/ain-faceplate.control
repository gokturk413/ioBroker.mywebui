{
 "properties": {
  "root": {
   "type": "signal",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  },
  "unit": {
   "type": "string",
   "default": ""
  }
 },
 "settings": {
  "width": "520px",
  "height": "600px"
 },
 "html": "<div class=\"fp\"><div class=\"fp-hdr\"><span class=\"fp-title\">[[this.root]]</span><button class=\"fp-adv-btn\" title=\"Advanced\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M4 6h10M4 12h16M4 18h7\"/><circle cx=\"17\" cy=\"6\" r=\"2\"/><circle cx=\"14\" cy=\"18\" r=\"2\"/></svg></button><button class=\"fp-x\">✕</button></div><div class=\"fp-desc\">Analog Input &nbsp;&#183;&nbsp; EU: [[this.unit||'&#8212;']]</div><div class=\"fp-tabs\" data-group=\"main\"><button class=\"fp-tab\" data-tab=\"Home\" title=\"Home\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M3 11l9-8 9 8\"/><path d=\"M5 10v10h14V10\"/></svg><span class=\"fp-tab-cap\">Home</span></button><button class=\"fp-tab\" data-tab=\"Maintenance\" title=\"Maintenance\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M14 6a3.5 3.5 0 00-4.8 4.2l-5 5 1.4 1.4 5-5A3.5 3.5 0 0014 6z\"/><circle cx=\"16.5\" cy=\"7.5\" r=\"1.2\"/></svg><span class=\"fp-tab-cap\">Maint</span></button><button class=\"fp-tab\" data-tab=\"Diagnostics\" title=\"Diagnostics\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M6 3v6a4 4 0 008 0V3\"/><path d=\"M10 15v2a4 4 0 008 0v-1\"/><circle cx=\"18\" cy=\"14\" r=\"2\"/></svg><span class=\"fp-tab-cap\">Diag</span></button><button class=\"fp-tab\" data-tab=\"Alarms\" title=\"Alarms\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.7 21a2 2 0 01-3.4 0\"/></svg><span class=\"fp-tab-badge\" bind-css:display=\"[[this.anyAlarm?'':'none']]\"></span></button><button class=\"fp-tab\" data-tab=\"Trend\" title=\"Trend\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M3 17l5-6 4 3 6-8\"/><path d=\"M3 21h18\"/></svg><span class=\"fp-tab-cap\">Trend</span></button></div><div class=\"fp-tabs hidden\" data-group=\"advanced\"><button class=\"fp-tab\" data-tab=\"Main\" title=\"Back to Main\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M15 6l-6 6 6 6\"/></svg><span class=\"fp-tab-cap\">Alarm</span></button><button class=\"fp-tab\" data-tab=\"Engineering\" title=\"Engineering\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1\"/></svg></button><button class=\"fp-tab\" data-tab=\"HMI\" title=\"HMI Config\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"1\"/><path d=\"M3 8h18\"/></svg></button><button class=\"fp-tab\" data-tab=\"Faults\" title=\"Faults\"><svg viewBox=\"0 0 24 24\" class=\"fp-ic\"><path d=\"M12 4v10\"/><circle cx=\"12\" cy=\"19\" r=\"0.6\"/></svg></button></div><div class=\"fp-body\"><div data-pane=\"Home\"><div class=\"fp-mai\"><webui-plantpax-components-level-bar id=\"lbar\"></webui-plantpax-components-level-bar><div class=\"fp-pv\"><div class=\"pv-big\">[[this.pv==null?'--':this.pv]]</div><div class=\"pv-eu\">[[this.unit||'']] &nbsp;·&nbsp; <span class=\"pv-mem\">Inp_PV</span></div><div class=\"fp-row\"><span class=\"lbl\">Quality</span><span bind-attr:class=\"[[this.pvBad?'qual bad':(this.pvUncertain?'qual unc':'qual good')]]\">[[this.pvBad?'BAD':(this.pvUncertain?'UNCERTAIN':'GOOD')]]</span></div><div class=\"fp-row\"><span class=\"lbl\">Source</span><span>[[this.substActive?'Substitute':'Input']]</span></div><div class=\"fp-row\"><span class=\"lbl\">Range</span><span>[[this.pvEuMin==null?'--':this.pvEuMin]] &#8212; [[this.pvEuMax==null?'--':this.pvEuMax]]</span></div><div class=\"fp-row\"><span class=\"lbl\">Substitute</span><span>[[this.substActive?'On':'Off']]</span></div></div></div><div class=\"fp-flags\"><webui-plantpax-components-status-flag data-pp=\"1\" field=\"sim\" label=\"Sim\" tone=\"warn\"></webui-plantpax-components-status-flag><webui-plantpax-components-status-flag data-pp=\"1\" field=\"maintByp\" label=\"Maint Byp\" tone=\"warn\"></webui-plantpax-components-status-flag><webui-plantpax-components-status-flag data-pp=\"1\" field=\"substActive\" label=\"Substitute\" tone=\"warn\"></webui-plantpax-components-status-flag><webui-plantpax-components-status-flag data-pp=\"1\" field=\"failAlarm\" label=\"Input Fail\" tone=\"crit\"></webui-plantpax-components-status-flag></div></div><div data-pane=\"Maintenance\" class=\"hidden\"><div class=\"fp-mrow head\"><span class=\"mnm\"></span><span class=\"mh\">Threshold</span><span class=\"mh\">Deadband</span></div><div class=\"fp-mrow\"><span class=\"mnm\">HiHi</span><input type=\"number\" class=\"mnum\" data-field=\"hiHiLim\" bind-prop:value=\"[[this.hiHiLim]]\" placeholder=\"limit\"><input type=\"number\" class=\"mnum\" data-field=\"hiHiDB\" bind-prop:value=\"[[this.hiHiDB]]\" placeholder=\"db\"></div><div class=\"fp-mrow\"><span class=\"mnm\">Hi</span><input type=\"number\" class=\"mnum\" data-field=\"hiLim\" bind-prop:value=\"[[this.hiLim]]\" placeholder=\"limit\"><input type=\"number\" class=\"mnum\" data-field=\"hiDB\" bind-prop:value=\"[[this.hiDB]]\" placeholder=\"db\"></div><div class=\"fp-mrow\"><span class=\"mnm\">Lo</span><input type=\"number\" class=\"mnum\" data-field=\"loLim\" bind-prop:value=\"[[this.loLim]]\" placeholder=\"limit\"><input type=\"number\" class=\"mnum\" data-field=\"loDB\" bind-prop:value=\"[[this.loDB]]\" placeholder=\"db\"></div><div class=\"fp-mrow\"><span class=\"mnm\">LoLo</span><input type=\"number\" class=\"mnum\" data-field=\"loLoLim\" bind-prop:value=\"[[this.loLoLim]]\" placeholder=\"limit\"><input type=\"number\" class=\"mnum\" data-field=\"loLoDB\" bind-prop:value=\"[[this.loLoDB]]\" placeholder=\"db\"></div><div class=\"fp-row\" style=\"margin-top:10px\"><span class=\"lbl\">Substitute PV</span><button class=\"fp-btn\" data-subst=\"1\">[[this.substActive?'Use Input':'Use Substitute']]</button></div></div><div data-pane=\"Engineering\" class=\"hidden\"><div class=\"fp-sec\">Raw Input Scaling</div><webui-plantpax-components-scaling-widget data-pp=\"1\" raw-min-field=\"inpRawMin\" raw-max-field=\"inpRawMax\" eu-min-field=\"pvEuMin\" eu-max-field=\"pvEuMax\"></webui-plantpax-components-scaling-widget><div class=\"fp-sec\">PV Source &amp; Quality</div><label class=\"fp-chk\"><input type=\"checkbox\" data-fieldb=\"useChanSrcQ\"><span>Use channel source quality</span><span class=\"m\">Cfg_UseChanSrcQ</span></label><label class=\"fp-chk\"><input type=\"checkbox\" data-fieldb=\"noSubstPV\"><span>Disable substitute PV selection</span><span class=\"m\">Cfg_NoSubstPV</span></label><div class=\"fp-row\"><span class=\"lbl cfg\"><b>Substitute PV value</b><span class=\"cfgmem\">Set_SubstPV</span></span><input type=\"number\" data-field=\"substPvSet\" bind-prop:value=\"[[this.substPvSet]]\"></div><div class=\"fp-sec\">Filtering &amp; Thresholds</div><div class=\"fp-row\"><span class=\"lbl cfg\"><b>PV filter time constant</b><span class=\"cfgmem\">Cfg_PVFiltTC</span></span><input type=\"number\" data-field=\"filtTC\" bind-prop:value=\"[[this.filtTC]]\"><span class=\"cfgunit\">s</span></div><div class=\"fp-row\"><span class=\"lbl cfg\"><b>Fail High limit</b><span class=\"cfgmem\">Cfg_FailHiLim</span></span><input type=\"number\" data-field=\"failHiLim\" bind-prop:value=\"[[this.failHiLim]]\"></div><div class=\"fp-row\"><span class=\"lbl cfg\"><b>Fail Low limit</b><span class=\"cfgmem\">Cfg_FailLoLim</span></span><input type=\"number\" data-field=\"failLoLim\" bind-prop:value=\"[[this.failLoLim]]\"></div><div class=\"fp-row\"><span class=\"lbl cfg\"><b>PV decimal places</b><span class=\"cfgmem\">Cfg_PVDecPlcs</span></span><input type=\"number\" data-field=\"pvDecPlcs\" bind-prop:value=\"[[this.pvDecPlcs]]\"></div></div><div data-pane=\"Trend\" class=\"hidden\"><div class=\"fp-sec\">PV Trend</div><webui-plantpax-components-sparkline id=\"sparkbig\" style=\"display:block;height:160px\" bind-prop:points=\"120\"></webui-plantpax-components-sparkline><div class=\"fp-row\" style=\"margin-top:6px\"><span class=\"lbl\">Current</span><span>[[this.pv==null?'--':this.pv]] [[this.unit||'']]</span></div></div><div data-pane=\"Diagnostics\" class=\"hidden\"><div class=\"fp-sec\">Signal Chain</div><div class=\"fp-row\"><span class=\"lbl\">Raw / Scaled Input</span><span>[[this.valInpPV==null?'--':this.valInpPV]]</span></div><div class=\"fp-row\"><span class=\"lbl\">Scaled PV (EU)</span><span>[[this.pv==null?'--':this.pv]] [[this.unit||'']]</span></div><div class=\"fp-row\"><span class=\"lbl\">PV Quality</span><span bind-attr:class=\"[[this.pvBad?'qual bad':(this.pvUncertain?'qual unc':'qual good')]]\">[[this.pvBad?'BAD':(this.pvUncertain?'UNCERTAIN':'GOOD')]]</span></div><div class=\"fp-row\"><span class=\"lbl\">Substitute Active</span><span>[[this.substActive?'YES':'no']]</span></div></div><div data-pane=\"Alarms\" class=\"hidden\"><div class=\"fp-almbar\"><span class=\"fp-unack\" bind-css:display=\"[[(this.unackCount||0)>0?'':'none']]\">[[this.unackCount||0]] unacked</span><span class=\"fp-grow\"></span><img class=\"fp-cmdimg\" data-ackall=\"1\" title=\"Acknowledge All\" src=\"data:image/png;base64,\"><img class=\"fp-cmdimg\" data-cmd=\"resetAckAll\" title=\"Reset and Acknowledge All\" src=\"data:image/png;base64,\"><img class=\"fp-cmdimg\" data-cmd=\"resetAll\" title=\"Reset\" src=\"data:image/png;base64,\"></div><webui-plantpax-components-alarm-row data-pp=\"1\" name=\"HiHi\" member=\"HiHi.Alm &#183; HiHi.Ack\" alarm-field=\"hiHiAlarm\" ack-field=\"hiHiAck\" severity=\"1000\"></webui-plantpax-components-alarm-row><webui-plantpax-components-alarm-row data-pp=\"1\" name=\"Hi\" member=\"Hi.Alm &#183; Hi.Ack\" alarm-field=\"hiAlarm\" ack-field=\"hiAck\" severity=\"500\"></webui-plantpax-components-alarm-row><webui-plantpax-components-alarm-row data-pp=\"1\" name=\"Lo\" member=\"Lo.Alm &#183; Lo.Ack\" alarm-field=\"loAlarm\" ack-field=\"loAck\" severity=\"500\"></webui-plantpax-components-alarm-row><webui-plantpax-components-alarm-row data-pp=\"1\" name=\"LoLo\" member=\"LoLo.Alm &#183; LoLo.Ack\" alarm-field=\"loLoAlarm\" ack-field=\"loLoAck\" severity=\"1000\"></webui-plantpax-components-alarm-row><webui-plantpax-components-alarm-row data-pp=\"1\" name=\"Fail\" member=\"Fail.Alm &#183; Fail.Ack\" alarm-field=\"failAlarm\" ack-field=\"failAck\" severity=\"1500\"></webui-plantpax-components-alarm-row></div><div data-pane=\"HMI\" class=\"hidden\"><div class=\"fp-sec\">HMI Configuration</div><div class=\"fp-row\"><span class=\"lbl\">Instance</span><span style=\"font-size:11px;word-break:break-all\">[[this.root]]</span></div><div class=\"fp-row\"><span class=\"lbl\">Type</span><span>[[this.type]]</span></div><div class=\"fp-row\"><span class=\"lbl\">EU Units</span><span>[[this.unit||'—']]</span></div></div><div data-pane=\"Faults\" class=\"hidden\"><div class=\"fp-sec\">Faults &amp; Status</div><div class=\"fp-alm\" bind-attr:class=\"[[this.failAlarm?'fp-alm active':'fp-alm']]\"><span class=\"fp-chip\"></span><span class=\"nm\">Input Fail</span></div><div class=\"fp-row\"><span class=\"lbl\">PV Bad</span><span>[[this.pvBad?'YES':'no']]</span></div><div class=\"fp-row\"><span class=\"lbl\">PV Uncertain</span><span>[[this.pvUncertain?'YES':'no']]</span></div></div></div></div>",
 "style": ":host{display:block;font-family:'Segoe UI',sans-serif;color:var(--ui-text,#e8e8ea);}.fp{display:flex;flex-direction:column;min-width:340px;font-size:13px;background:var(--ui-surface,#1a212b);border-radius:8px;overflow:hidden;}.fp-hdr{display:flex;align-items:center;gap:8px;padding:11px 13px;background:var(--ui-surface-2,#232e3d);}.fp-title{font-weight:640;flex:1;font-size:13px;font-family:monospace;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.fp-x{cursor:pointer;background:none;border:none;color:var(--ui-text,#e8e8ea);font-size:15px;opacity:.85;padding:2px 7px;border-radius:4px;}.fp-x:hover{background:rgba(255,255,255,.1);}.fp-adv-btn{cursor:pointer;background:none;border:none;color:var(--ui-text,#e8e8ea);opacity:.85;padding:3px;display:flex;border-radius:4px;}.fp-adv-btn:hover{background:rgba(255,255,255,.1);}.fp-desc{padding:6px 13px;font-size:11.5px;color:var(--ui-dim,#9aa4b2);border-bottom:1px solid var(--ui-border,#2b3542);}.fp-tabs{display:flex;background:var(--ui-surface-2,#1e2732);border-bottom:1px solid var(--ui-border,#2b3542);}.fp-tab{flex:1;position:relative;padding:8px 2px;cursor:pointer;background:none;border:none;color:var(--ui-dim,#9aa4b2);display:flex;flex-direction:column;align-items:center;gap:3px;border-right:1px solid var(--ui-border,#222b36);}.fp-tab:last-child{border-right:none;}.fp-tab:hover{color:var(--ui-text,#e8e8ea);}.fp-tab.sel{color:var(--accent,#5b9bff);background:var(--ui-surface,#1a212b);}.fp-tab.sel::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--accent,#5b9bff);}.fp-tab-cap{font-size:9px;letter-spacing:.02em;}.fp-ic{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}.fp-tab-badge{position:absolute;top:5px;right:calc(50% - 15px);width:7px;height:7px;border-radius:50%;background:var(--ui-error,#e5484d);}.fp-body{padding:14px 15px;}.fp-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 0;border-top:1px solid var(--ui-border,#222b36);font-size:12.5px;}.fp-row:first-child{border-top:none;}.fp-row .lbl{opacity:.7;}.fp-row input{width:90px;flex:none;text-align:right;padding:4px 8px;background:var(--ui-surface-2,#2f3545);color:var(--ui-text,#e8e8ea);border:1px solid var(--ui-border,#4a5570);border-radius:4px;font-family:monospace;}.fp-btn{padding:5px 11px;background:var(--accent,#2680eb);color:#fff;border:none;border-radius:5px;cursor:pointer;font-size:11px;}.fp-btn.ghost{background:none;border:1px solid var(--ui-border,#4a5570);color:var(--ui-text,#e8e8ea);}.fp-alm{display:flex;align-items:center;gap:8px;margin-bottom:6px;}.fp-chip{width:12px;height:12px;border-radius:50%;background:var(--ui-ok,#30a46c);}.fp-alm.active .fp-chip{background:var(--ui-error,#e5484d);}.fp-alm .nm{flex:1;font-size:12px;}.fp-mai{display:flex;gap:16px;align-items:stretch;}.fp-mai webui-plantpax-components-level-bar{flex:none;}.fp-pv{flex:1;display:flex;flex-direction:column;}.pv-big{font-size:36px;font-weight:710;letter-spacing:-.02em;line-height:1;}.pv-eu{font-size:12px;opacity:.7;margin:3px 0 8px;}.pv-mem{font-family:monospace;font-size:10px;color:var(--accent,#5b9bff);opacity:.8;}.fp-flags{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}.fp-sec{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ui-dim,#9aa4b2);margin:14px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--ui-border,#222b36);}.fp-sec:first-child{margin-top:2px;}.fp-mrow{display:flex;align-items:center;gap:8px;margin-bottom:5px;}.fp-mrow .mnm{width:44px;font-size:12px;opacity:.8;}.fp-mrow .mh{flex:1;text-align:center;font-size:10px;opacity:.6;text-transform:uppercase;}.fp-mrow.head{margin-bottom:6px;}.fp-mrow input.mnum{flex:1;width:0;padding:4px;background:var(--ui-surface-2,#2f3545);color:var(--ui-text,#e8e8ea);border:1px solid var(--ui-border,#4a5570);border-radius:4px;font-size:12px;}.fp-chk{display:flex;align-items:center;gap:8px;font-size:12.5px;margin:8px 0;cursor:pointer;}.fp-chk .m{margin-left:auto;font-family:monospace;font-size:9.5px;color:var(--accent,#5b9bff);opacity:.75;}.fp-row .lbl.cfg{display:flex;flex-direction:column;gap:1px;opacity:1;}.fp-row .lbl.cfg b{font-weight:500;font-size:12.5px;}.cfgmem{font-family:monospace;font-size:9.5px;color:var(--accent,#5b9bff);opacity:.75;}.cfgunit{font-family:monospace;font-size:11px;color:var(--ui-dim,#9aa4b2);margin-left:6px;}.fp-almbar{display:flex;align-items:center;gap:8px;margin-bottom:12px;}.fp-grow{flex:1;}.fp-unack{font-size:12px;color:var(--ui-error,#e5484d);font-weight:600;}.fp-cmdimg{width:34px;height:34px;cursor:pointer;flex:none;margin-left:4px;border-radius:4px;}.fp-cmdimg:hover{background:rgba(255,255,255,.08);}.qual{font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:6px;}.qual::after{content:'';width:8px;height:8px;border-radius:50%;background:currentColor;order:2;}.qual.good{color:var(--ui-ok,#30a46c);}.qual.unc{color:var(--ui-warn,#f6b73c);}.qual.bad{color:var(--ui-error,#e5484d);}.hidden{display:none!important;}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action,element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n// wire symbol click -> open faceplate (event bindings can't eval expressions here, so bind imperatively)\nfunction ppWireSymbol(instance){\n  const el=instance._getDomElement&&instance._getDomElement('sym'); if(!el) return;\n  el.addEventListener('click',function(){ try{ window.IOB && window.IOB.openFaceplate && window.IOB.openFaceplate(instance.type,instance.root); }catch(e){} });\n}\n// wire faceplate header + icon tab-strip clicks imperatively\nfunction ppWireHeader(instance){\n  if(!instance._getDomElements) return;\n  for(const b of instance._getDomElements('.fp-x')){ b.addEventListener('click',function(){ try{ window.IOB && window.IOB.closeFaceplate && window.IOB.closeFaceplate(); }catch(e){} }); }\n  for(const b of instance._getDomElements('.fp-adv-btn')){ b.addEventListener('click',function(){ instance._adv&&instance._adv(); }); }\n  for(const t of instance._getDomElements('.fp-tab')){ (function(btn){ btn.addEventListener('click',function(){ const n=btn.getAttribute('data-tab'); if(n==='Main'){ instance._main&&instance._main(); } else { instance._tab&&instance._tab(n); } }); })(t); }\n}\n\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function' || typeof instance._getDomElements!=='function') return;\n  instance.pv=null; instance.pvBad=false; instance.pvUncertain=false; instance.substActive=false;\n  instance.anyAlarm=false;\n  const ALM=[\"hiHiAlarm\", \"hiAlarm\", \"loAlarm\", \"loLoAlarm\", \"failAlarm\"];\n  const recomputeAlm=function(){ let any=false; for(const a of ALM){ if(instance[a]===true||instance[a]==='true'||instance[a]===1){ any=true; break; } } instance.anyAlarm=any; try{ instance._bindingsRefresh&&instance._bindingsRefresh(); }catch(e){} };\n  const subs=[\"pv\", \"pvBad\", \"pvUncertain\", \"substActive\", \"valInpPV\", \"unackCount\", \"hiHiLim\", \"hiHiDB\", \"hiLim\", \"hiDB\", \"loLim\", \"loDB\", \"loLoLim\", \"loLoDB\", \"inpRawMax\", \"inpRawMin\", \"pvEuMax\", \"pvEuMin\", \"filtTC\", \"noSubstPV\", \"hiHiAlarm\", \"hiAlarm\", \"loAlarm\", \"loLoAlarm\", \"failAlarm\", \"useChanSrcQ\", \"substPvSet\", \"failHiLim\", \"failLoLim\", \"pvDecPlcs\"];\n  // bind-prop:value=\"[[...]]\" never reaches input.value (the [[..]] parser consumes\n  // the attribute but writes a junk 'bindProp:value' expando) -> fill numeric\n  // [data-field] inputs imperatively; skip while the operator is typing in it.\n  const setNum=function(field,v){ for(const inp of instance._getDomElements('input[data-field=\"'+field+'\"]')){ if(!inp.matches(':focus')) inp.value=(v===null||v===undefined)?'':v; } };\n  for(const f of subs){ (function(field){ ppSubscribe(instance,field,function(v){\n    if(field==='pvBad'||field==='pvUncertain'||field==='substActive'){ instance[field]=(v===true||v==='true'||v===1); }\n    else { instance[field]=v; setNum(field,v); }\n    if(field==='pv') instance.pv=v;\n    if(ALM.indexOf(field)>=0){ instance[field]=(v===true||v==='true'||v===1); recomputeAlm(); }\n  }); })(f); }\n  // reflect boolean checkbox states from live values\n  const setChecks=function(){ for(const cb of instance._getDomElements('[data-fieldb]')){ const f=cb.getAttribute('data-fieldb'); cb.checked=(instance[f]===true||instance[f]==='true'||instance[f]===1); } };\n  instance._tab=function(name){\n    for(const p of instance._getDomElements('[data-pane]')) p.classList.toggle('hidden', p.getAttribute('data-pane')!==name);\n    for(const t of instance._getDomElements('.fp-tab')) t.classList.toggle('sel', t.getAttribute('data-tab')===name);\n    if(name==='Engineering') setChecks();\n  };\n  // switch to the Advanced icon-strip (Engineering/HMI/Faults) and back to Main\n  instance._adv=function(){\n    for(const g of instance._getDomElements('[data-group]')) g.classList.toggle('hidden', g.getAttribute('data-group')!=='advanced');\n    instance._tab('Engineering');\n  };\n  instance._main=function(){\n    for(const g of instance._getDomElements('[data-group]')) g.classList.toggle('hidden', g.getAttribute('data-group')!=='main');\n    instance._tab('Home');\n  };\n  ppWireHeader(instance);\n  instance._tab('Home');\n  // wire nested components by id (level-bar + sparklines get the EU unit too)\n  (function(){ for(const cid of ['lbar','spark','sparkbig']){ const c=instance._getDomElement(cid); if(c){ c.root=instance.root; c.type=instance.type; c.unit=instance.unit;\n    if(typeof c._ppReinit==='function'){ c._ppReinit(); } else { (function(cc){ setTimeout(function(){ cc._ppReinit&&cc._ppReinit(); },200); })(c); } } } })();\n  // wire composed [data-pp] components (alarm-row / scaling-widget / status-flag): give root/type + start\n  for(const c of instance._getDomElements('[data-pp]')){ c.root=instance.root; c.type=instance.type;\n    if(typeof c._ppReinit==='function'){ c._ppReinit(); } else { (function(cc){ setTimeout(function(){ cc._ppReinit&&cc._ppReinit(); },200); })(c); } }\n  const can=function(action){ return (window.IOB && typeof window.IOB.secCan==='function') ? window.IOB.secCan(action,instance) : true; };\n  const gate=function(){\n    const cfg=can('configure'), mnt=can('maintenance'), ack=can('ackAlarm');\n    for(const i of instance._getDomElements('[data-field],[data-fieldb]')) i.disabled=!cfg;\n    for(const b of instance._getDomElements('[data-subst]')) b.classList.toggle('hidden',!mnt);\n    for(const b of instance._getDomElements('[data-ack],[data-ackall]')) b.classList.toggle('hidden',!ack);\n    for(const i of instance._getDomElements('.fp-mrow input')) i.disabled=!mnt;\n  };\n  gate();\n  try{ window.IOB && window.IOB.securityChanged && window.IOB.securityChanged.on && window.IOB.securityChanged.on(gate); }catch(e){}\n  // numeric config writes\n  for(const i of instance._getDomElements('[data-field]')){\n    (function(inp){ inp.addEventListener('change',function(){ ppWrite(instance,inp.getAttribute('data-field'),Number(inp.value),'configure'); }); })(i);\n  }\n  // boolean checkbox writes\n  for(const cb of instance._getDomElements('[data-fieldb]')){\n    (function(box){ box.addEventListener('change',function(){ ppWrite(instance,box.getAttribute('data-fieldb'),box.checked,'configure'); }); })(cb);\n  }\n  // substitute PV source toggle (maintenance)\n  for(const b of instance._getDomElements('[data-subst]')){\n    b.addEventListener('click',function(){ if(instance.substActive){ ppWrite(instance,'cmdInpPV',1,'maintenance'); } else { ppWrite(instance,'cmdSubstPV',1,'maintenance'); } });\n  }\n  // alarm ack\n  const ackMap={\"HiHi\": \"hiHiAck\", \"Hi\": \"hiAck\", \"Lo\": \"loAck\", \"LoLo\": \"loLoAck\", \"Fail\": \"failAck\"};\n  for(const b of instance._getDomElements('[data-ack]')){\n    (function(btn){ btn.addEventListener('click',function(){ const nm=btn.closest('.fp-alm').querySelector('.nm').textContent; ppWrite(instance,ackMap[nm]||btn.getAttribute('data-ack'),1,'ackAlarm'); }); })(b);\n  }\n  for(const b of instance._getDomElements('[data-ackall]')){\n    b.addEventListener('click',function(){ for(const k in ackMap) ppWrite(instance,ackMap[k],1,'ackAlarm'); });\n  }\n  // global alarm-set commands (Reset & Ack All / Reset)\n  for(const b of instance._getDomElements('[data-cmd]')){\n    (function(btn){ btn.addEventListener('click',function(){ ppWrite(instance,btn.getAttribute('data-cmd'),1,'ackAlarm'); }); })(b);\n  }\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}