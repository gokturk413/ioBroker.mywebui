{
 "properties": {
  "root": {
   "type": "signal",
   "default": ""
  },
  "type": {
   "type": "string",
   "default": "P_AIn"
  },
  "unit": {
   "type": "string",
   "default": ""
  }
 },
 "settings": {
  "width": "96px",
  "height": "48px"
 },
 "html": "<div id=\"sym\" class=\"pp-sym\"><span class=\"pp-pv\">[[this.pv==null?'--':this.pv]]</span><span class=\"pp-unit\">[[this.unit||'']]</span><span class=\"pp-badge\" css:display=\"[[this.unacked?'':'none']]\"></span></div>",
 "style": ":host{display:block;width:100%;height:100%;font-family:'Segoe UI',sans-serif;}.pp-sym{position:relative;display:flex;align-items:baseline;gap:4px;justify-content:center;height:100%;box-sizing:border-box;padding:4px 8px;border-radius:4px;cursor:pointer;background:var(--pp-bg,var(--ui-surface-2,#2f3545));color:var(--ui-text,#e8e8ea);border:1px solid var(--ui-border,#4a5570);}.pp-pv{font-size:18px;font-weight:700;}.pp-unit{font-size:11px;opacity:.7;}.pp-badge{position:absolute;top:2px;right:2px;width:8px;height:8px;border-radius:50%;background:var(--ui-warn,#f6b73c);}",
 "script": "\nfunction ppResolve(instance,field){ try{ return window.IOB.resolvePlantPaxField(instance.type,instance.root,field); }catch(e){ return null; } }\nfunction ppSubscribe(instance,field,onVal){\n  const id=ppResolve(instance,field); if(!id) return;\n  instance.__ppSubs=instance.__ppSubs||[];\n  const cb=(_i,s)=>{ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} };\n  try{ window.IOB.getState(id).then(function(s){ onVal(s&&s.val); try{instance._bindingsRefresh&&instance._bindingsRefresh();}catch(e){} }).catch(function(){}); }catch(e){}\n  try{ window.IOB.subscribeState(id,cb); instance.__ppSubs.push([id,cb]); }catch(e){}\n}\nfunction ppCleanup(instance){\n  for(const pair of (instance.__ppSubs||[])){ try{ window.IOB.unsubscribeState(pair[0],pair[1]); }catch(e){} }\n  instance.__ppSubs=[];\n}\nasync function ppWrite(instance,field,val,action){\n  const id=ppResolve(instance,field); if(!id) return;\n  try{ await window.IOB.secWriteState(id,val,{action:action,element:instance}); }catch(e){ console.warn('[plantpax] write failed',field,e); }\n}\n// adapter-data-gating: hide el when the resolved member does not exist on the adapter\n// (real .gfx controls are included only when our adapter actually exposes the member).\nasync function ppHideIfMissing(instance,field,el){\n  if(!el) return;\n  const id=ppResolve(instance,field);\n  if(!id){ el.style.display='none'; return; }\n  try{\n    const o=await window.IOB.getObject(id).catch(function(){ return null; });\n    if(o){ el.style.display=''; return; }\n    const s=await window.IOB.getState(id).catch(function(){ return null; });\n    el.style.display=(s===null||s===undefined)?'none':'';\n  }catch(e){}\n}\n// wire symbol click -> open faceplate (event bindings can't eval expressions here, so bind imperatively)\nfunction ppWireSymbol(instance){\n  const el=instance._getDomElement&&instance._getDomElement('sym'); if(!el) return;\n  el.addEventListener('click',function(){ try{ window.IOB && window.IOB.openFaceplate && window.IOB.openFaceplate(instance.type,instance.root); }catch(e){} });\n}\n// wire faceplate header + icon tab-strip clicks imperatively\nfunction ppWireHeader(instance){\n  if(!instance._getDomElements) return;\n  for(const b of instance._getDomElements('.fp-x')){ b.addEventListener('click',function(){ try{ window.IOB && window.IOB.closeFaceplate && window.IOB.closeFaceplate(); }catch(e){} }); }\n  for(const b of instance._getDomElements('.fp-adv-btn')){ b.addEventListener('click',function(){ instance._adv&&instance._adv(); }); }\n  for(const t of instance._getDomElements('.fp-tab')){ (function(btn){ btn.addEventListener('click',function(){ const n=btn.getAttribute('data-tab'); if(n==='Main'){ instance._main&&instance._main(); } else { instance._tab&&instance._tab(n); } }); })(t); }\n}\n\nexport function init(instance){\n  if(!instance || typeof instance._getDomElement!=='function' || typeof instance._getDomElements!=='function') return;\n  instance.pv=null; instance.unacked=0; instance.__alm={}; instance.__sts={};\n  ppSubscribe(instance,'pv',function(v){ instance.pv=v; });\n  const alarms=[\"hiHiAlarm\", \"hiAlarm\", \"loAlarm\", \"loLoAlarm\", \"failAlarm\"];\n  for(const a of alarms){ (function(name){ ppSubscribe(instance,name,function(v){ instance.__alm[name]=(v===true||v==='true'||v===1); ppSymColor(instance); }); })(a); }\n  // threshold-status bits (Sts_*) so the symbol tracks the MAI colour even before an alarm annunciates\n  for(const s of ['hiHiSts','hiSts','loSts','loLoSts']){ (function(name){ ppSubscribe(instance,name,function(v){ instance.__sts[name]=(v===true||v==='true'||v===1); ppSymColor(instance); }); })(s); }\n  ppWireSymbol(instance);\n}\nfunction ppSymColor(instance){\n  const A=instance.__alm||{}, S=instance.__sts||{};\n  const hi2=A.hiHiAlarm||A.loLoAlarm||S.hiHiSts||S.loLoSts, hi1=A.hiAlarm||A.loAlarm||S.hiSts||S.loSts, fail=A.failAlarm;\n  const el=instance._getDomElement('sym');\n  const c=(hi2||fail)?'var(--ui-error,#e5484d)':(hi1?'var(--ui-warn,#f6b73c)':'var(--ui-ok,#30a46c)');\n  if(el) el.style.setProperty('--pp-bg', c);\n  // annunciated (unacked) badge tracks the real alarm objects only, not raw threshold status\n  instance.unacked=(A.hiHiAlarm||A.loLoAlarm||A.hiAlarm||A.loAlarm||A.failAlarm)?1:0;\n  try{ instance._bindingsRefresh&&instance._bindingsRefresh(); }catch(e){}\n}\nexport function disconnectedCallback(instance){ ppCleanup(instance); }\n"
}