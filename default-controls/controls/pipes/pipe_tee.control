{"html": "<div class=\"responsive-container\" style=\"width:100%;height:100%;position:relative;\"><svg id=\"tee_svg\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 112.5 112.5\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"none\" xml:space=\"preserve\" style=\"display:block;\"></svg></div>", "script": "export function init(instance){\n    instance._bindingsRefresh?.();\n    instance._assignEvent('tee-type-changed', (ev) => updateTee(ev.detail.newValue, instance));\n    instance._assignEvent('pipesize-changed', (ev) => updatesize(ev.detail.newValue, instance));\n    const sz = ((parseFloat(instance.pipesize)||100) * 2);\n    instance.style.width = sz + 'px';\n    instance.style.height = sz + 'px';\n    updateTee(instance.teeType, instance);\n}\nfunction updatesize(value, instance){\n    const sz = ((parseFloat(value)||100) * 2);\n    instance.style.width = sz + 'px';\n    instance.style.height = sz + 'px';\n}\nfunction updateTee(teeType, instance){\n    const svg = instance._getDomElement('tee_svg');\n    if(!svg) return;\n    teeType = teeType || instance.teeType || '1';\n    const L = '<stop offset=\"0.01\" stop-color=\"#646566\"/><stop offset=\"0.16\" stop-color=\"#909091\"/><stop offset=\"0.49\" stop-color=\"#E0E0E0\"/><stop offset=\"1\" stop-color=\"#646566\"/>';\n    const defs = '<linearGradient id=\"tH\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"41.25\" x2=\"0\" y2=\"71.25\">'+L+'</linearGradient><linearGradient id=\"tV\" gradientUnits=\"userSpaceOnUse\" x1=\"41.25\" y1=\"0\" x2=\"71.25\" y2=\"0\">'+L+'</linearGradient>';\n    const barH = '<path d=\"M0,56.25 H112.5\" fill=\"none\" stroke=\"url(#tH)\" stroke-width=\"30\" stroke-linecap=\"butt\"></path>';\n    const barV = '<path d=\"M56.25,0 V112.5\" fill=\"none\" stroke=\"url(#tV)\" stroke-width=\"30\" stroke-linecap=\"butt\"></path>';\n    const stubDown  = '<path d=\"M31.25,71.25 L41.25,79.25 L41.25,112.5 L71.25,112.5 L71.25,79.25 L81.25,71.25 Z\" fill=\"url(#tV)\"></path>';\n    const stubUp    = '<path d=\"M31.25,41.25 L41.25,33.25 L41.25,0 L71.25,0 L71.25,33.25 L81.25,41.25 Z\" fill=\"url(#tV)\"></path>';\n    const stubRight = '<path d=\"M71.25,31.25 L79.25,41.25 L112.5,41.25 L112.5,71.25 L79.25,71.25 L71.25,81.25 Z\" fill=\"url(#tH)\"></path>';\n    const stubLeft  = '<path d=\"M41.25,31.25 L33.25,41.25 L0,41.25 L0,71.25 L33.25,71.25 L41.25,81.25 Z\" fill=\"url(#tH)\"></path>';\n    const tees = { '1': defs+stubDown+barH, '2': defs+stubUp+barH, '3': defs+stubRight+barV, '4': defs+stubLeft+barV };\n    svg.innerHTML = tees[teeType] || tees['1'];\n}", "properties": {"teeType": {"type": "enum", "default": "1", "values": ["1", "2", "3", "4"]}, "pipesize": {"type": "number", "default": "100"}}, "settings": {"visibilityEnabled": "false", "visibilityGroups": "", "visibilityAction": "hide", "visibilityRedirectScreen": ""}}