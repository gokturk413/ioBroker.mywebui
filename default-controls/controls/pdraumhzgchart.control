{"html":"<div class=\"grid-container\">\n    <div>\n        <span>Solltemperatur:&nbsp;</span><span bind-content:html=\"??solltemperatur\"></span><span>°C&nbsp;</span><span>Isttemperatur:&nbsp;</span><span bind-content:html=\"??isttemperatur\"></span><span>°C&nbsp;</span><span>Ventilstellung:&nbsp;</span><span bind-content:html=\"??ventilstellung\"></span><span>%</span>\n    </div>\n    <div>\n        <iframe bind-prop:src=\"??echart\" class=\"echart\"></iframe>\n    </div>\n</div>\n","style":"#root {\n\n}\n\n* {\n    box-sizing: border-box;\n}\n\n.grid-container {\n    background-color: lightgray;\n    border-style: solid;\n    border-width: 1px;\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: 1em 1fr;\n}\n\n.statusanzeige{\n    margin-left: 5px;\n}\n\n.echart{\n    width: 600px;\n    height: 400px;\n    margin: 5px;    \n}","properties":{"echart":{"type":"string"},"solltemperatur":{"type":"string"},"isttemperatur":{"type":"string"},"ventilstellung":{"type":"string"}},"settings":{}}