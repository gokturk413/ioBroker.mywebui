{"html":"<style>\n    @import '/webui.0.widgets/node_modules/@shoelace-style/shoelace/dist/themes/light.css';\n</style>\n<sl-button variant=\"primary\" loading style=\"width:194px;height:53px;position:absolute;left:100px;top:139px;\"></sl-button>\n<sl-carousel loop navigation pagination autoplay style=\"width:549px;height:370px;position:absolute;left:439px;top:49px;\"></sl-carousel>\n","style":":host {\n       background: rgba(0, 0, 0, 0) linear-gradient(rgb(240, 249, 255) 0%, rgb(203, 235, 255) 47%, rgb(161, 219, 255) 100%) repeat scroll 0% 0% / auto padding-box border-box;\n}\n\n* {\n    box-sizing: border-box;\n}","script":"  // Bütün lazımi komponentləri import edin\r\nimport '@shoelace-style/shoelace/dist/components/carousel/carousel.js';\r\nimport '@shoelace-style/shoelace/dist/components/carousel-item/carousel-item.js';\r\nimport '@shoelace-style/shoelace/dist/components/button/button.js';\r\nimport '@shoelace-style/shoelace/dist/components/icon/icon.js';\r\nimport { setBasePath } from '@shoelace-style/shoelace/dist/utilities/base-path.js';\r\n\r\n// Base path təyin edin\r\nsetBasePath('/webui.0.widgets/node_modules/@shoelace-style/shoelace/dist');","properties":{"relativesignalpath":{"type":"string"},"valveid":{"type":"number"}},"settings":{"visibilityEnabled":"false","visibilityGroups":"","visibilityAction":"hide","visibilityRedirectScreen":""}}